---
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<section class="video-section">
  <div class="container">
    <h2 class="section-title">Assista o convite das professoras:</h2>
    <div class="video-grid">
      <!-- Video Cássia -->
      <div class="video-card">
        <div class="video-wrapper">
          <iframe 
            src="https://www.youtube.com/embed/M5NVmTIQgWI" 
            title="Convite Prof. Cássia Helena"
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
        <p class="video-caption">Prof. Cássia Helena</p>
      </div>

      <!-- Video Jéssica -->
      <div class="video-card">
        <div class="video-wrapper">
          <iframe 
            src="https://www.youtube.com/embed/vPnW2rWVQHY" 
            title="Convite Prof. Jéssica Wszolek"
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
        <p class="video-caption">Prof. Jéssica Wszolek</p>
      </div>
    </div>
  </div>
</section>

<style>
  .video-section {
    padding: var(--space-xl) var(--space-sm);
    background: transparent;
  }
  .section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: var(--space-xl);
    font-weight: 800;
    color: var(--color-text);
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .video-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .video-wrapper {
    position: relative;
    padding-bottom: 177.77%; /* 9:16 Aspect Ratio */
    height: 0;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    background: #000;
    border: 4px solid white;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .video-wrapper:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 30px 60px rgba(0,0,0,0.25);
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .video-caption {
    text-align: center;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .video-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .section-title {
      font-size: 1.875rem;
    }
    .video-wrapper {
        max-width: 320px;
        margin: 0 auto;
    }
  }
</style>
