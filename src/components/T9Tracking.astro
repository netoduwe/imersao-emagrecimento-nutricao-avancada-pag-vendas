---
const endpoint = 'https://qjkezuofhunqzbchlhru.supabase.co/functions/v1/t9-track-event';
---

<script is:inline define:vars={{ endpoint }}>
  (() => {
    const SESSION_KEY = 't9_session_id';
    const ATTRIBUTION_KEY = 't9_attribution';
    const CHECKOUT_FLOW_KEY = 't9_checkout_flow_v1';
    const CHECKOUT_EXPERIMENT_ID = 't9-checkout-flow-20260722';
    const CHECKOUT_EXPERIMENT_PATHS = new Set(['/imersao-5ed-v2', '/imersao-5ed-v8']);
    const EVENT_NAMES = new Set([
      'page_view', 'view_content', 'ticket_section_view', 'ticket_cta_click',
      'form_open', 'form_start', 'form_submit', 'checkout_view'
    ]);
    const params = new URLSearchParams(location.search);
    let sessionId = localStorage.getItem(SESSION_KEY);
    if (!sessionId) {
      sessionId = crypto.randomUUID();
      localStorage.setItem(SESSION_KEY, sessionId);
    }
    const sessionToken = sessionId.replace(/[^a-zA-Z0-9]/g, '').slice(0, 12).toLowerCase();
    const currentPath = location.pathname.replace(/\/+$/, '') || '/';
    const forcedCheckoutFlow = params.get('t9_checkout_flow');
    let checkoutFlow = null;
    if (CHECKOUT_EXPERIMENT_PATHS.has(currentPath)) {
      if (forcedCheckoutFlow === 'form' || forcedCheckoutFlow === 'direct') {
        checkoutFlow = forcedCheckoutFlow;
      } else {
        const savedCheckoutFlow = localStorage.getItem(CHECKOUT_FLOW_KEY);
        if (savedCheckoutFlow === 'form' || savedCheckoutFlow === 'direct') {
          checkoutFlow = savedCheckoutFlow;
        } else {
          checkoutFlow = crypto.getRandomValues(new Uint32Array(1))[0] % 2 === 0 ? 'form' : 'direct';
          localStorage.setItem(CHECKOUT_FLOW_KEY, checkoutFlow);
        }
      }
    }

    const cookie = (name) => document.cookie
      .split('; ')
      .find((row) => row.startsWith(`${name}=`))
      ?.split('=')
      .slice(1)
      .join('=') || null;

    let savedAttribution = {};
    try { savedAttribution = JSON.parse(localStorage.getItem(ATTRIBUTION_KEY) || '{}'); } catch {}
    const currentAttribution = {
      utm_source: params.get('utm_source'),
      utm_medium: params.get('utm_medium'),
      utm_campaign: params.get('utm_campaign'),
      utm_content: params.get('utm_content'),
      utm_term: params.get('utm_term'),
      campaign_id: params.get('campaign_id') || params.get('campaign'),
      adset_id: params.get('adset_id') || params.get('adset'),
      ad_id: params.get('ad_id') || params.get('ad'),
      placement: params.get('placement') || params.get('utm_medium'),
      fbp: cookie('_fbp'),
      fbc: cookie('_fbc')
    };
    const attribution = Object.fromEntries(Object.entries({ ...savedAttribution, ...currentAttribution })
      .filter(([, value]) => value !== null && value !== undefined && value !== ''));
    localStorage.setItem(ATTRIBUTION_KEY, JSON.stringify(attribution));
    const deviceType = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)
      ? (/iPad|Tablet/i.test(navigator.userAgent) ? 'tablet' : 'mobile')
      : 'desktop';

    const track = (eventName, details = {}) => {
      if (!EVENT_NAMES.has(eventName)) return;
      const payload = {
        event_name: eventName,
        event_id: crypto.randomUUID(),
        session_id: sessionId,
        occurred_at: new Date().toISOString(),
        ticket_type: details.ticket_type || null,
        device_type: deviceType,
        ...attribution,
        page_url: location.href,
        metadata: details.metadata || {}
      };
      const body = JSON.stringify(payload);
      if (!navigator.sendBeacon(endpoint, new Blob([body], { type: 'text/plain' }))) {
        fetch(endpoint, { method: 'POST', headers: { 'content-type': 'text/plain' }, body, keepalive: true }).catch(() => {});
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: `t9_${eventName}`, ...payload });
    };

    const checkoutExperimentMetadata = checkoutFlow ? {
      checkout_flow: checkoutFlow,
      experiment_id: CHECKOUT_EXPERIMENT_ID,
      session_token: sessionToken,
      forced_variant: forcedCheckoutFlow === 'form' || forcedCheckoutFlow === 'direct'
    } : {};

    window.T9Tracking = {
      sessionId,
      sessionToken,
      attribution,
      track,
      checkoutFlow,
      checkoutExperimentId: CHECKOUT_EXPERIMENT_ID
    };
    track('page_view', { metadata: checkoutExperimentMetadata });
    track('view_content');

    const ticketSection = document.getElementById('ingressos') || document.querySelector('[data-form]')?.closest('section');
    if (ticketSection && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          track('ticket_section_view');
          observer.disconnect();
        }
      }, { threshold: 0.25 });
      observer.observe(ticketSection);
    }

    document.querySelectorAll('[data-form]').forEach((button) => {
      button.addEventListener('click', () => track('ticket_cta_click', {
        ticket_type: button.dataset.form === 'vip' ? 'vip' : 'basic',
        metadata: checkoutExperimentMetadata
      }));
    });

    addEventListener('t9:form-open', (event) => track('form_open', event.detail || {}));
    addEventListener('message', (event) => {
      if (!event.origin.endsWith('fullfunnel.app')) return;
      const data = typeof event.data === 'string' ? (() => { try { return JSON.parse(event.data); } catch { return {}; } })() : event.data || {};
      const eventName = data.event_name || data.event;
      if (['form_start', 'form_submit', 'checkout_view'].includes(eventName)) {
        track(eventName, {
          ticket_type: data.ticket_type,
          metadata: { source: 'fullfunnel_message', ...checkoutExperimentMetadata }
        });
      }
    });
  })();
</script>
