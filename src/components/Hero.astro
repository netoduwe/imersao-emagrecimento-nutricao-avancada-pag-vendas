---
import CTAButton from './CTAButton.astro';
import PriceCard from './PriceCard.astro';
import BenefitsGrid from './BenefitsGrid.astro';

interface Props {
  variant?: 'green' | 'blue';
}

const { variant = 'green' } = Astro.props;
const neyImage = "https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png";
---

<section class="hero-ultimate-fidelity">
  <div class="container hero-grid-fidelity">
    <!-- LEFT COLUMN -->
    <div class="hero-text-side">
      <div class="badge-v4">
        <span class="icon">📅</span> 16 de Maio | 9h às 18h
      </div>

      <h1 class="headline-v4">
        Um dia inteiro de <span class="serif-italic">Imersão</span><br/>
        em <span class="highlight-line">atualização</span> no tratamento<br/>
        do <span class="green-text">sobrepeso e obesidade</span>
      </h1>

      <p class="subhead-v4">
        Domine as evidências mais atuais do emagrecimento e aplique na <span class="bold-green">prática clínica</span> com segurança.
      </p>

      <!-- CTA and PRICE CARD WRAPPER FOR PERFECT ALIGNMENT -->
      <div class="conversion-block-v4">
        <div class="cta-wrap-v4">
          <CTAButton text="COMPRAR INGRESSO LOTE ATUAL" href="#preco" />
        </div>

        <div class="price-wrap-v4">
          <PriceCard />
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="hero-visual-side">
      <div class="image-stack">
        <div class="bg-glow"></div>
        <img src={neyImage} alt="Ney Felipe" class="ney-photo" />
        
        <div class="floating-list-card">
          <div class="list-item">
            <div class="li-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
            <div class="li-text">
              <strong>Atualizações baseadas</strong>
              <span>em ciência de verdade</span>
            </div>
          </div>
          <div class="list-item">
            <div class="li-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></div>
            <div class="li-text">
              <strong>Protocolos aplicáveis</strong>
              <span>na prática clínica</span>
            </div>
          </div>
          <div class="list-item">
            <div class="li-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></div>
            <div class="li-text">
              <strong>Resultados reais</strong>
              <span>para seus pacientes</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-bottom-bar-v4">
    <div class="container footer-grid-v4">
      <div class="f-item">
        <div class="f-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
        <div class="f-text"><strong>UM DIA INTENSO</strong><span>de muito conteúdo</span></div>
      </div>
      <div class="f-sep"></div>
      <div class="f-item">
        <div class="f-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></div>
        <div class="f-text"><strong>FOCO TOTAL</strong><span>em prática clínica</span></div>
      </div>
      <div class="f-sep"></div>
      <div class="f-item">
        <div class="f-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
        <div class="f-text"><strong>NETWORKING</strong><span>com quem faz acontecer</span></div>
      </div>
      <div class="f-sep"></div>
      <div class="f-item">
        <div class="f-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
        <div class="f-text"><strong>CERTIFICADO</strong><span>de participação</span></div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="spoiler-v4">
       <div class="s-icon">🛡️</div>
       <p><strong>Spoiler:</strong> Essa não é apenas uma imersão de teoria, você também vai aprender sobre <strong>prática clínica</strong> e como ir <strong>além do déficit calórico</strong> quando o assunto é emagrecimento.</p>
    </div>
  </div>
</section>

<style>
  .hero-ultimate-fidelity {
    background-color: #F7F8F6;
    background-image: linear-gradient(to bottom, rgba(22, 163, 74, 0.05), transparent 40%);
    padding-top: 60px;
    position: relative;
    overflow: hidden;
  }

  .hero-grid-fidelity {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
    padding-bottom: 40px;
  }

  .hero-text-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* FORCE LEFT ALIGNMENT */
    text-align: left;
  }

  .badge-v4 {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f0fdf4;
    color: #16A34A;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 24px;
    border: 1px solid #dcfce7;
  }

  .headline-v4 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    font-weight: 800;
    color: #111827;
    margin-bottom: 20px;
    letter-spacing: -0.04em;
  }

  .serif-italic {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    color: #16A34A;
  }

  .highlight-line {
    position: relative;
    display: inline-block;
  }
  
  .highlight-line::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 0;
    width: 100%;
    height: 6px;
    background: rgba(22, 163, 74, 0.1);
    z-index: -1;
  }

  .green-text { color: #16A34A; }

  .subhead-v4 {
    color: #4B5563;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 540px;
  }

  .conversion-block-v4 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .cta-wrap-v4 { width: 100%; max-width: 440px; }
  .price-wrap-v4 { width: 100%; max-width: 440px; }

  /* Visual Side */
  .hero-visual-side { position: relative; }
  .image-stack { position: relative; display: flex; justify-content: center; }

  .ney-photo {
    width: 100%;
    max-width: 520px;
    z-index: 5;
    mask-image: linear-gradient(to top, transparent 0%, black 20%);
  }

  .bg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 130%;
    height: 130%;
    background: radial-gradient(circle, rgba(22, 163, 74, 0.08) 0%, transparent 70%);
    z-index: 1;
  }

  .floating-list-card {
    position: absolute;
    right: -20px;
    bottom: 100px;
    background: white;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 280px;
    z-index: 10;
    border: 1px solid #F9FAFB;
  }

  .list-item { display: flex; align-items: center; gap: 12px; }
  .li-icon {
    width: 32px;
    height: 32px;
    background: #f0fdf4;
    color: #16A34A;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .li-text { display: flex; flex-direction: column; }
  .li-text strong { font-size: 13px; color: #111827; line-height: 1.2; }
  .li-text span { font-size: 11px; color: #6B7280; }

  /* Bottom Bar */
  .hero-bottom-bar-v4 {
    background: #FFFFFF;
    border-top: 1px solid #F3F4F6;
    padding: 32px 0;
    margin-top: 20px;
  }

  .footer-grid-v4 {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .f-item { display: flex; align-items: center; gap: 12px; }
  .f-icon { color: #16A34A; opacity: 0.8; }
  .f-text { display: flex; flex-direction: column; }
  .f-text strong { font-size: 13px; font-weight: 800; color: #111827; letter-spacing: 0.02em; }
  .f-text span { font-size: 11px; color: #6B7280; }
  .f-sep { width: 1px; height: 32px; background: #E5E7EB; }

  /* Spoiler */
  .spoiler-v4 {
    margin: 40px auto;
    max-width: 900px;
    background: rgba(22, 163, 74, 0.04);
    border-radius: 16px;
    padding: 20px 24px;
    display: flex;
    gap: 16px;
    align-items: center;
    border: 1px solid rgba(22, 163, 74, 0.08);
  }

  .spoiler-v4 p { font-size: 14px; line-height: 1.6; color: #4B5563; margin: 0; }

  @media (max-width: 1024px) {
    .hero-grid-fidelity { grid-template-columns: 1fr; text-align: center; gap: 4rem; }
    .hero-text-side { align-items: center; text-align: center; }
    .conversion-block-v4 { align-items: center; }
    .subhead-v4 { margin-left: auto; margin-right: auto; }
    .floating-list-card { position: relative; right: auto; bottom: auto; margin: 2rem auto 0; width: 100%; max-width: 320px; }
    .footer-grid-v4 { flex-direction: column; gap: 2rem; }
    .f-sep { display: none; }
    .spoiler-v4 { flex-direction: column; text-align: center; }
  }
</style>
