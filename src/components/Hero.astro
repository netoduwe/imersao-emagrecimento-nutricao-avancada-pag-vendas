---
import ProgressBar from './ProgressBar.astro';

interface Props {
  variant?: 'green' | 'blue';
}

const { variant = 'green' } = Astro.props;

const primaryColor = variant === 'green' ? '#1AA824' : '#2563EB';
const neyImage = "https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png";
---

<section class={`hero-premium ${variant}`}>
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="date-badge">
        <span class="icon">📅</span> 16 de Maio | 9h às 18h
      </div>

      <h1 class="hero-title">
        Um dia inteiro de <span class="italic">Imersão</span> em <span class="underline">atualização</span> no tratamento do <span class="accent">sobrepeso e obesidade</span>
      </h1>

      <p class="hero-subtitle">
        Domine as evidências mais atuais do emagrecimento e aplique na <strong>prática clínica</strong> com segurança.
      </p>

      <div class="hero-actions">
        <a href="#preco" class="btn-shiny">
          <span class="btn-text">COMPRAR INGRESSO LOTE ATUAL</span>
          <div class="btn-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </div>
        </a>
      </div>

      <div class="pricing-card">
        <div class="card-header">
          <span class="lote-badge">🔥 LOTE ZERO</span>
          <div class="price">
            <span class="label">POR APENAS</span>
            <span class="value">R$ 19,90</span>
          </div>
        </div>
        <ProgressBar variant="hero" />
      </div>
    </div>

    <div class="hero-visual">
      <div class="image-wrapper">
        <div class="blob"></div>
        <img src={neyImage} alt="Ney Felipe" class="ney-img" />
      </div>

      <div class="floating-features">
        <div class="feature-card">
          <div class="f-icon green">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <p>Atualizações baseadas em ciência de verdade</p>
        </div>
        <div class="feature-card">
          <div class="f-icon green">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <p>Protocolos aplicáveis na prática clínica</p>
        </div>
        <div class="feature-card">
          <div class="f-icon green">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
          </div>
          <p>Resultados reais para seus pacientes</p>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-footer-bar">
    <div class="container bar-grid">
      <div class="bar-item">
        <div class="bar-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="bar-text">
          <strong>UM DIA INTENSO</strong>
          <span>de muito conteúdo</span>
        </div>
      </div>
      <div class="bar-divider"></div>
      <div class="bar-item">
        <div class="bar-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
        </div>
        <div class="bar-text">
          <strong>FOCO TOTAL</strong>
          <span>em prática clínica</span>
        </div>
      </div>
      <div class="bar-divider"></div>
      <div class="bar-item">
        <div class="bar-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <div class="bar-text">
          <strong>NETWORKING</strong>
          <span>com quem faz acontecer</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style define:vars={{ primaryColor }}>
  .hero-premium {
    padding-top: 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-premium.blue {
    background: #030712;
    color: #ffffff;
  }
  
  .hero-premium.green {
    background: #ffffff;
    color: #1a1a1a;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .date-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(var(--primary-rgb), 0.05);
    padding: 0.5rem 1.25rem;
    border-radius: 99px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primaryColor);
    margin-bottom: 2rem;
    border: 1px solid rgba(var(--primary-rgb), 0.1);
  }

  .hero-premium.green .date-badge {
      background: #f0fdf4;
      border: 1px solid #dcfce7;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  .hero-title .italic {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .hero-title .underline {
    position: relative;
    display: inline-block;
  }
  
  .hero-title .underline::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--primaryColor);
    opacity: 0.3;
    z-index: -1;
  }

  .hero-title .accent {
    color: var(--primaryColor);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    margin-bottom: 3rem;
  }

  /* Pricing Card */
  .pricing-card {
    background: white;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    max-width: 450px;
  }

  .hero-premium.blue .pricing-card {
    background: #111827;
    border-color: rgba(255,255,255,0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .lote-badge {
    background: var(--primaryColor);
    color: white;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.4rem 0.8rem;
    border-radius: 99px;
  }

  .price {
    text-align: right;
  }

  .price .label {
    display: block;
    font-size: 0.65rem;
    color: var(--color-text-light);
    font-weight: 700;
  }

  .price .value {
    font-size: 1.75rem;
    font-weight: 800;
  }

  /* Visual Column */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
  }

  .blob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, var(--primaryColor) 0%, transparent 70%);
    opacity: 0.1;
    z-index: -1;
  }

  .ney-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
  }

  .floating-features {
    position: absolute;
    bottom: 10%;
    right: -10%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    z-index: 20;
  }

  .feature-card {
    background: white;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 280px;
    animation: floating 3s ease-in-out infinite;
  }

  .hero-premium.blue .feature-card {
    background: #111827;
    border-color: rgba(255,255,255,0.08);
    color: #fff;
  }

  .feature-card:nth-child(2) { animation-delay: 0.5s; }
  .feature-card:nth-child(3) { animation-delay: 1s; }

  @keyframes floating {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .f-icon {
    width: 32px;
    height: 32px;
    background: rgba(var(--primary-rgb), 0.1);
    color: var(--primaryColor);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-card p {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  /* Footer Bar */
  .hero-footer-bar {
    margin-top: 4rem;
    background: rgba(var(--primary-rgb), 0.02);
    border-top: 1px solid rgba(var(--primary-rgb), 0.05);
    padding: 2.5rem 0;
  }

  .hero-premium.blue .hero-footer-bar {
    background: rgba(255,255,255,0.02);
  }

  .bar-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
  }

  .bar-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bar-icon {
    color: var(--primaryColor);
    opacity: 0.7;
  }

  .bar-text {
    display: flex;
    flex-direction: column;
  }

  .bar-text strong {
    font-size: 0.875rem;
    letter-spacing: 0.05em;
  }

  .bar-text span {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .bar-divider {
    width: 1px;
    height: 40px;
    background: rgba(var(--primary-rgb), 0.1);
  }

  /* Responsive Mobile */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .pricing-card {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-visual {
      order: -1;
    }

    .floating-features {
      right: 0;
      bottom: -20px;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }

    .bar-grid {
      flex-direction: column;
      gap: 2rem;
    }

    .bar-divider {
      display: none;
    }
  }
</style>
