---
import CTAButton from './CTAButton.astro';
import PriceCard from './PriceCard.astro';
import BenefitsGrid from './BenefitsGrid.astro';

interface Props {
  variant?: 'green' | 'blue';
}

const { variant = 'green' } = Astro.props;
const neyImage = "https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png";
---

<section class="hero-reborn">
  <div class="container hero-wrapper">
    <!-- COLUNA ESQUERDA (TEXTO) -->
    <div class="hero-content-column">
      <div class="date-badge-pill">
        <span>📅 16 de Maio | 9h às 18h</span>
      </div>

      <h1 class="headline-reborn">
        Um dia inteiro de<br/>
        <span class="playfair-green">Imersão</span> em<br/>
        <span class="highlight-stroke">atualização</span> no tratamento do<br/>
        <span class="green-bold">sobrepeso e obesidade</span>
      </h1>

      <p class="subhead-reborn">
        Domine as evidências mais atuais do emagrecimento e aplique na prática clínica com segurança.
      </p>

      <div class="cta-section">
        <CTAButton text="COMPRAR INGRESSO LOTE ATUAL" href="#preco" />
      </div>

      <div class="price-section">
        <PriceCard />
      </div>
    </div>

    <!-- COLUNA DIREITA (IMAGEM) -->
    <div class="hero-visual-column">
      <div class="ney-visual-container">
         <div class="gradient-aura-v2"></div>
         <img src={neyImage} alt="Ney Felipe" class="ney-image-main" />
         
         <div class="floating-benefit-card-premium">
            <div class="fb-icon">🔬</div>
            <div class="fb-text">
              <strong>Ciência na Prática</strong>
              <span>Protocolos baseados em evidências</span>
            </div>
         </div>
      </div>
    </div>
  </div>

  <div class="hero-footer-bar">
    <div class="container benefits-footer-grid">
      <BenefitsGrid />
    </div>
  </div>

  <div class="container">
    <div class="hero-spoiler-final">
       <div class="s-icon">🛡️</div>
       <p><strong>Spoiler:</strong> Essa não é apenas uma imersão de teoria, você também vai aprender sobre <strong>prática clínica</strong> e como ir <strong>além do déficit calórico</strong> quando o assunto é emagrecimento.</p>
    </div>
  </div>
</section>

<style>
  .hero-reborn {
    background-color: #F7F8F6;
    background-image: linear-gradient(to bottom, rgba(22, 163, 74, 0.08), transparent 40%);
    padding: 48px 0 0;
    position: relative;
    overflow: hidden;
  }

  .hero-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-content-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
    z-index: 10;
  }

  .date-badge-pill {
    background: rgba(22, 163, 74, 0.1);
    color: #16A34A;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 24px;
    border: 1px solid rgba(22, 163, 74, 0.1);
  }

  .headline-reborn {
    font-size: clamp(28px, 8vw, 36px);
    line-height: 1.1;
    font-weight: 800;
    color: #111827;
    margin-bottom: 20px;
    letter-spacing: -0.03em;
  }

  .playfair-green {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: #16A34A;
    font-weight: 400;
  }

  .highlight-stroke {
    position: relative;
    display: inline-block;
  }
  
  .highlight-stroke::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 8px;
    background: rgba(22, 163, 74, 0.15);
    z-index: -1;
  }

  .green-bold { color: #16A34A; }

  .subhead-reborn {
    color: #4B5563;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .cta-section { width: 100%; margin-bottom: 24px; }
  .price-section { width: 100%; margin-bottom: 40px; }

  .hero-visual-column {
    width: 100%;
    position: relative;
    margin-top: 20px;
  }

  .ney-visual-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .ney-image-main {
    width: 100%;
    max-width: 500px;
    height: auto;
    object-fit: contain;
    mask-image: linear-gradient(to top, transparent 0%, black 20%);
    z-index: 5;
  }

  .gradient-aura-v2 {
    position: absolute;
    bottom: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 150%;
    height: 100%;
    background: radial-gradient(circle, rgba(22, 163, 74, 0.1) 0%, transparent 70%);
    z-index: 1;
  }

  .floating-benefit-card-premium {
    position: absolute;
    right: 5%;
    bottom: 30%;
    background: white;
    padding: 12px 16px;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10;
    border: 1px solid #F3F4F6;
  }

  .fb-icon { font-size: 20px; }
  .fb-text { display: flex; flex-direction: column; text-align: left; }
  .fb-text strong { font-size: 12px; color: #111827; }
  .fb-text span { font-size: 10px; color: #6B7280; }

  .hero-footer-bar {
    background: white;
    border-top: 1px solid #F3F4F6;
    padding: 24px 0;
    margin-top: -20px;
    position: relative;
    z-index: 10;
  }

  .hero-spoiler-final {
    margin: 32px auto;
    background: rgba(22, 163, 74, 0.04);
    border: 1px solid rgba(22, 163, 74, 0.08);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    text-align: left;
  }

  .hero-spoiler-final p { font-size: 14px; color: #374151; line-height: 1.6; margin: 0; }

  @media (min-width: 1024px) {
    .hero-reborn { padding-top: 80px; }
    .hero-wrapper {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: 60px;
    }
    .hero-content-column { align-items: flex-start; max-width: 600px; }
    .headline-reborn { font-size: 56px; }
    .hero-visual-column { margin-top: 0; }
  }
</style>
