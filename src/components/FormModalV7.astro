---
/**
 * FormModal.astro
 * Modal com iframe do formulário GHL (pre-checkout).
 */
---

<div id="form-modal" class="modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
  <div class="modal-content">
    <button class="modal-close" id="modal-close" aria-label="Fechar">&times;</button>
    <div class="modal-head">
      <span>Último passo</span>
      <h2 id="checkout-title">Garanta sua vaga</h2>
      <p>Preencha seus dados para continuar no checkout seguro.</p>
    </div>
    <iframe
      id="modal-iframe"
      src=""
      style="width:100%;height:380px;border:none;display:block;"
      title="Formulário de Ingresso"
    ></iframe>
    <div id="form-loading" class="form-loading" role="status" aria-live="polite">
      <span class="form-loading-spinner" aria-hidden="true"></span>
      <span>Carregando inscrição...</span>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(1, 7, 3, 0.88);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
  }

  .modal-content {
    background: #f5f4ed;
    border-radius: 22px;
    width: min(94%, 480px);
    max-height: 92dvh;
    overflow: auto;
    position: relative;
    padding: 1.25rem;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.3s ease;
    border: 1px solid rgba(255,255,255,0.05);
  }

  .modal-content iframe {
    border-radius: 12px;
    background: #fff;
  }

  .modal-content iframe.is-hydrating { opacity: 0; pointer-events: none; }
  .form-loading {
    display: none;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    min-height: 380px;
    color: #17201c;
    background: #fff;
    border-radius: 12px;
  }
  .form-loading.is-visible { display: flex; }
  .form-loading-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(0, 0, 0, .14);
    border-top-color: #15966a;
    border-radius: 50%;
    animation: formSpin .8s linear infinite;
  }
  @keyframes formSpin { to { transform: rotate(360deg); } }

  .modal-head { padding: 6px 8px 14px; color: #071209; }
  .modal-head span { color:#087c36; font-size:11px; font-weight:900; letter-spacing:.14em; text-transform:uppercase; }
  .modal-head h2 { margin:5px 0 3px; font-size:28px; letter-spacing:-.04em; }
  .modal-head p { margin:0; color:#5c675e; font-size:14px; }

  .modal-close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #20df73;
    color: #041108;
    border: 3px solid #071209;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.2s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }

  .modal-close:hover {
    transform: scale(1.1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (max-width: 520px) {
    .modal-overlay { align-items: flex-end; }
    .modal-content { width:100%; max-height:94dvh; border-radius:22px 22px 0 0; padding:14px; }
    .modal-close { top:12px; right:12px; }
    .modal-content iframe { height:410px !important; }
  }

</style>

<script>
  const FORMS = {
    normal: 'https://links.fullfunnel.app/widget/form/Z1AkP8zQTM494tXR8loP',
    vip: 'https://links.fullfunnel.app/widget/form/XuSUwksfyVTSPoPKdMe8'
  };
  const CHECKOUTS = {
    normal: 'https://pay.hotmart.com/Y105539078H?off=rzzgx17r&checkoutMode=10',
    vip: 'https://pay.hotmart.com/W93818806I?off=l3p9qwc8&checkoutMode=10'
  };

  const modal = document.getElementById('form-modal');
  const iframe = document.getElementById('modal-iframe') as HTMLIFrameElement;
  const loading = document.getElementById('form-loading');
  const closeBtn = document.getElementById('modal-close');
  function beginHydration() {
    iframe.classList.add('is-hydrating');
    loading?.classList.add('is-visible');
    modal?.setAttribute('aria-busy', 'true');
  }

  function finishHydration() {
    iframe.classList.remove('is-hydrating');
    loading?.classList.remove('is-visible');
    modal?.setAttribute('aria-busy', 'false');
  }

  iframe.addEventListener('load', () => {
    if (!iframe.src) return;
    // A atribuição e o session id já seguem na URL antes deste carregamento.
    finishHydration();
  });

  function buildTrackedFormUrl(baseUrl: string) {
    const formUrl = new URL(baseUrl);
    const currentParams = new URLSearchParams(window.location.search);

    currentParams.forEach((value, key) => {
      if (value) formUrl.searchParams.set(key, value);
    });

    const savedAttribution = (window as any).T9Tracking?.attribution || {};
    Object.entries(savedAttribution).forEach(([key, value]) => {
      if (value && !formUrl.searchParams.has(key)) formUrl.searchParams.set(key, String(value));
    });

    const sessionId = (window as any).T9Tracking?.sessionId;
    if (sessionId) formUrl.searchParams.set('t9_session_id', sessionId);

    return formUrl.toString();
  }

  function buildTrackedCheckoutUrl(baseUrl: string, type: 'normal' | 'vip') {
    const checkoutUrl = new URL(baseUrl);
    const currentParams = new URLSearchParams(window.location.search);
    currentParams.delete('t9_checkout_flow');
    currentParams.forEach((value, key) => {
      if (value) checkoutUrl.searchParams.set(key, value);
    });

    const tracking = (window as any).T9Tracking;
    Object.entries(tracking?.attribution || {}).forEach(([key, value]) => {
      if (value && !checkoutUrl.searchParams.has(key)) checkoutUrl.searchParams.set(key, String(value));
    });
    const token = String(tracking?.sessionToken || tracking?.sessionId || '')
      .replace(/[^a-zA-Z0-9]/g, '')
      .slice(0, 12)
      .toLowerCase();
    checkoutUrl.searchParams.set('sck', `t9d-${type === 'vip' ? 'v' : 'b'}-${token || 'semid'}`);
    return checkoutUrl.toString();
  }

  // Abrir modal
  document.querySelectorAll('[data-form]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const type = (btn as HTMLElement).dataset.form;
      const formUrl = type ? FORMS[type as keyof typeof FORMS] : undefined;
      const checkoutUrl = type ? CHECKOUTS[type as keyof typeof CHECKOUTS] : undefined;
      const tracking = (window as any).T9Tracking;
      const ticketType = type === 'vip' ? 'vip' : 'basic';

      if (tracking?.checkoutFlow === 'direct' && checkoutUrl && (type === 'normal' || type === 'vip')) {
        const destination = buildTrackedCheckoutUrl(checkoutUrl, type);
        const sck = new URL(destination).searchParams.get('sck');
        tracking.track?.('checkout_view', {
          ticket_type: ticketType,
          metadata: {
            checkout_flow: 'direct',
            experiment_id: tracking.checkoutExperimentId,
            session_token: tracking.sessionToken,
            destination: 'hotmart',
            sck
          }
        });
        window.location.assign(destination);
        return;
      }

      if (formUrl) {
        beginHydration();
        iframe.src = buildTrackedFormUrl(formUrl);
        modal!.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        window.dispatchEvent(new CustomEvent('t9:form-open', {
          detail: {
            ticket_type: ticketType,
            metadata: {
              checkout_flow: 'form',
              experiment_id: tracking?.checkoutExperimentId,
              session_token: tracking?.sessionToken
            }
          }
        }));
      }
    });
  });

  // Fechar modal
  function closeModal() {
    modal!.style.display = 'none';
    iframe.src = '';
    finishHydration();
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
