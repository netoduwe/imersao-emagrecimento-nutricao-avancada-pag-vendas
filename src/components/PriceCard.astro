---
interface Props {
  variant?: 'green' | 'red';
}

const { variant = 'green' } = Astro.props;
---

<div class="price-card-v3" data-price-card data-variant={variant}>
  <div class="pc-top">
    <div class="pc-badge" style={variant === 'red' ? 'background: #dc2626;' : ''}>🔥 LOTE 01</div>
    <div class="pc-price">
      <span class="pc-label">POR APENAS</span>
      <span class="pc-value" data-pc-price>R$ 29,90</span>
    </div>
  </div>
  
  <div class="pc-progress-wrap">
    <div class="pc-bar-bg">
      <div class="pc-bar-fill" data-pc-fill style="width: 3%"></div>
    </div>
  </div>

  <div class="pc-footer">
    <span data-pc-pct>3% vendidos</span>
    <span data-pc-remaining>97 restantes</span>
  </div>
</div>

<style>
  .price-card-v3 {
    background: white;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    width: 100%;
    margin: 0;
    border: 1px solid #F3F4F6;
  }

  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    gap: 12px;
  }

  .pc-badge {
    background: #16A34A;
    color: white;
    padding: 4px 12px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pc-price {
    text-align: right;
    min-width: 0;
  }

  .pc-label {
    display: block;
    font-size: 10px;
    color: #6B7280;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .pc-value {
    font-size: 24px;
    font-weight: 800;
    color: #111827;
    white-space: nowrap;
  }

  .pc-progress-wrap {
    margin-bottom: 8px;
  }

  .pc-bar-bg {
    width: 100%;
    height: 8px;
    background: #E5E7EB;
    border-radius: 99px;
    overflow: hidden;
  }

  .pc-bar-fill {
    height: 100%;
    background: #16A34A;
    border-radius: 99px;
    transition: width 1s ease-out;
  }

  .pc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .pc-value {
      font-size: 20px;
    }
    .pc-top {
      gap: 8px;
    }
  }
</style>

<script>
  // Datas predefinidas para viradas de lotes (Evento: 01/08/2026)
  const LOTES = [
    { nome: 'LOTE ZERO', inicio: new Date('2026-06-01T00:00:00').getTime(), limite: new Date('2026-07-15T23:59:59').getTime(), preco: 'R$ 19,90' },
    { nome: 'LOTE 01', inicio: new Date('2026-07-15T00:00:00').getTime(), limite: new Date('2026-07-21T23:59:59').getTime(), preco: 'R$ 24,90' },
    { nome: 'LOTE 02', inicio: new Date('2026-07-21T00:00:00').getTime(), limite: new Date('2026-07-30T23:59:59').getTime(), preco: 'R$ 29,90' },
    { nome: 'LOTE 03', inicio: new Date('2026-07-30T00:00:00').getTime(), limite: new Date('2026-08-01T09:00:00').getTime(), preco: 'R$ 39,90' }
  ];

  function updatePriceCards() {
    const now = new Date().getTime();
    
    // Identificar lote ativo
    let lote = LOTES[LOTES.length - 1];
    for (let i = 0; i < LOTES.length; i++) {
      if (now < LOTES[i].limite) {
        lote = LOTES[i];
        break;
      }
    }

    const totalDuration = lote.limite - lote.inicio;
    const elapsed = now - lote.inicio;
    
    // Porcentagem baseada no tempo (mínimo de 65%, máximo 99%)
    let percent = 65;
    if (elapsed > 0 && totalDuration > 0) {
      const calculatedPct = 65 + (34 * (elapsed / totalDuration));
      percent = Math.min(Math.max(calculatedPct, 65), 99);
    }
    
    const visualPercent = Math.min(percent, 100);

    const cards = document.querySelectorAll('[data-price-card]');
    cards.forEach(card => {
       const fill = card.querySelector('[data-pc-fill]') as HTMLElement;
       const pct = card.querySelector('[data-pc-pct]');
       const rem = card.querySelector('[data-pc-remaining]');
       const price = card.querySelector('[data-pc-price]');

       if(fill) {
         fill.style.width = `${Math.max(visualPercent, 5)}%`;
         
         // Troca dinâmica de cor (ou força se for red)
         if (card.getAttribute('data-variant') === 'red') {
           fill.style.background = '#dc2626'; // Vermelho forçado
         } else if (visualPercent > 90) {
           fill.style.background = '#ef4444'; // Vermelho
         } else if (visualPercent > 70) {
           fill.style.background = '#f59e0b'; // Laranja
         } else {
           fill.style.background = '#16A34A'; // Verde
         }
       }
       
       if(pct) pct.textContent = `${Math.floor(percent)}% dos ingressos vendidos`;
       
       // Contador regressivo ou virada de lote
       const diff = lote.limite - now;
       if(rem) {
         if (diff > 0) {
           const d = Math.floor(diff / (1000 * 60 * 60 * 24));
           const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
           const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
           const s = Math.floor((diff % (1000 * 60)) / 1000);
           rem.textContent = `virada de lote em: ${d}d ${h}h ${m}m ${s}s`;
         } else {
           rem.textContent = `vagas limitadas`;
         }
       }
       if(price) price.textContent = lote.preco;
    });
  }

  updatePriceCards();
  setInterval(updatePriceCards, 1000);
</script>
