---
import { IMERSAO_5ED_CURRENT_LOT } from '../config/imersao-5ed';

interface Props {
  variant?: 'green' | 'red';
}

const { variant = 'green' } = Astro.props;
const currentLot = IMERSAO_5ED_CURRENT_LOT;
---

<div
  class="price-card-v3"
  data-price-card
  data-variant={variant}
  data-lot-name={currentLot.labelUpper}
  data-lot-price={currentLot.basicPrice}
  data-lot-start={currentLot.startsAt}
  data-lot-end={currentLot.endsAt}
>
  <div class="pc-top">
    <div class="pc-badge" data-pc-badge style={variant === 'red' ? 'background: #dc2626;' : ''}>🔥 {currentLot.labelUpper}</div>
    <div class="pc-price">
      <span class="pc-label">POR APENAS</span>
      <span class="pc-value" data-pc-price>{currentLot.basicPrice}</span>
    </div>
  </div>
  
  <div class="pc-progress-wrap">
    <div class="pc-bar-bg">
      <div class="pc-bar-fill" data-pc-fill style="width: 3%"></div>
    </div>
  </div>

  <div class="pc-footer">
    <span data-pc-pct>3% vendidos</span>
    <span data-pc-remaining>97 restantes</span>
  </div>
</div>

<style>
  .price-card-v3 {
    background: white;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    width: 100%;
    margin: 0;
    border: 1px solid #F3F4F6;
  }

  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    gap: 12px;
  }

  .pc-badge {
    background: #16A34A;
    color: white;
    padding: 4px 12px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pc-price {
    text-align: right;
    min-width: 0;
  }

  .pc-label {
    display: block;
    font-size: 10px;
    color: #6B7280;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .pc-value {
    font-size: 24px;
    font-weight: 800;
    color: #111827;
    white-space: nowrap;
  }

  .pc-progress-wrap {
    margin-bottom: 8px;
  }

  .pc-bar-bg {
    width: 100%;
    height: 8px;
    background: #E5E7EB;
    border-radius: 99px;
    overflow: hidden;
  }

  .pc-bar-fill {
    height: 100%;
    background: #16A34A;
    border-radius: 99px;
    transition: width 1s ease-out;
  }

  .pc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .pc-value {
      font-size: 20px;
    }
    .pc-top {
      gap: 8px;
    }
  }
</style>

<script>
  function updatePriceCards() {
    const now = new Date().getTime();

    const cards = document.querySelectorAll('[data-price-card]');
    cards.forEach(card => {
       const element = card as HTMLElement;
       const lotName = element.dataset.lotName || 'LOTE ATUAL';
       const lotPrice = element.dataset.lotPrice || '';
       const lotStart = new Date(element.dataset.lotStart || '').getTime();
       const lotEnd = new Date(element.dataset.lotEnd || '').getTime();
       const totalDuration = lotEnd - lotStart;
       const elapsed = now - lotStart;

       let percent = 65;
       if (elapsed > 0 && totalDuration > 0) {
         const calculatedPct = 65 + (34 * (elapsed / totalDuration));
         percent = Math.min(Math.max(calculatedPct, 65), 99);
       }

       const visualPercent = Math.min(percent, 100);
       const fill = card.querySelector('[data-pc-fill]') as HTMLElement;
       const pct = card.querySelector('[data-pc-pct]');
       const rem = card.querySelector('[data-pc-remaining]');
       const price = card.querySelector('[data-pc-price]');
       const badge = card.querySelector('[data-pc-badge]');

       if(fill) {
         fill.style.width = `${Math.max(visualPercent, 5)}%`;
         
         // Troca dinâmica de cor (ou força se for red)
         if (card.getAttribute('data-variant') === 'red') {
           fill.style.background = '#dc2626'; // Vermelho forçado
         } else if (visualPercent > 90) {
           fill.style.background = '#ef4444'; // Vermelho
         } else if (visualPercent > 70) {
           fill.style.background = '#f59e0b'; // Laranja
         } else {
           fill.style.background = '#16A34A'; // Verde
         }
       }
       
       if(pct) pct.textContent = `${Math.floor(percent)}% dos ingressos vendidos`;
       
       // Contador regressivo ou virada de lote
       const diff = lotEnd - now;
       if(rem) {
          if (diff > 0) {
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((diff % (1000 * 60)) / 1000);
            rem.textContent = `encerra em: ${d}d ${h}h ${m}m ${s}s`;
          } else {
           rem.textContent = `vagas limitadas`;
         }
       }
       if(price) price.textContent = lotPrice;
       if(badge) badge.textContent = `🔥 ${lotName}`;
    });
  }

  updatePriceCards();
  setInterval(updatePriceCards, 1000);
</script>
