---
interface Props {
  variant?: 'green' | 'blue';
}

const { variant = 'green' } = Astro.props;
const accentColor = variant === 'green' ? '#16A34A' : '#2563EB';

const timeline = [
  { time: "09:00", label: "Início", icon: "🚀" },
  { time: "12:00", label: "Almoço", icon: "🍴" },
  { time: "13:30", label: "Retorno", icon: "📚" },
  { time: "17:30", label: "Encerramento*", icon: "✨" }
];
---

<section id="cronograma" class={`schedule-section ${variant}`}>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Cronograma</h2>
      <p class="section-subtitle">Uma jornada completa de atualização</p>
    </div>

    <div class="timeline-container-v4">
      <!-- Horizontal Line (Desktop Only) -->
      <div class="timeline-main-line"></div>

      <div class="timeline-items-grid">
        {timeline.map((item) => (
          <div class="timeline-item-v4">
            <!-- Node (Desktop only for this design) -->
            <div class="node-wrapper desktop-only">
              <div class="timeline-node"></div>
              <div class="dotted-connector"></div>
            </div>

            <!-- Card with Glassmorphism -->
            <div class="schedule-card-v4 glass-premium">
              <div class="card-icon">{item.icon}</div>
              <div class="card-time">{item.time}</div>
              <div class="card-divider"></div>
              <div class="card-label">{item.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-note">
      <span class="info-icon">ℹ️</span>
      <p>*Pode haver variações conforme o aprofundamento dos temas.</p>
    </div>
  </div>
</section>

<style define:vars={{ accentColor }}>
  .schedule-section {
    padding: 80px 0;
    background-color: #030712;
    color: white;
    overflow: hidden;
  }

  .schedule-section.green {
    background-color: #F9FAFB;
    color: #111827;
  }

  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 15px;
    color: #9CA3AF;
  }

  .timeline-container-v4 {
    position: relative;
    padding-top: 20px;
  }

  /* Horizontal Line Desktop */
  .timeline-main-line {
    position: absolute;
    top: 34px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 1;
  }

  .schedule-section.green .timeline-main-line {
    background: rgba(0, 0, 0, 0.04);
  }

  .timeline-items-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .timeline-item-v4 {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Node Desktop */
  .node-wrapper.desktop-only {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
  }

  .timeline-node {
    width: 12px;
    height: 12px;
    background: var(--accentColor);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accentColor);
  }

  .dotted-connector {
    width: 1px;
    height: 30px;
    border-left: 1px dotted rgba(255, 255, 255, 0.2);
    margin-top: 4px;
  }

  /* Glassmorphism Card */
  .glass-premium {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 20px;
    width: 100%;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
  }

  .schedule-section.green .glass-premium {
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(0, 0, 0, 0.05);
    color: #111827;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.03);
  }

  .card-icon {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .card-time {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .card-divider {
    width: 24px;
    height: 2px;
    background: var(--accentColor);
    margin: 0 auto 10px;
    border-radius: 99px;
  }

  .card-label {
    font-size: 13px;
    font-weight: 600;
    color: #9CA3AF;
  }

  .schedule-section.green .card-label { color: #6B7280; }

  /* Footer Note */
  .footer-note {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    color: #6B7280;
    font-size: 12px;
    margin-top: 30px;
  }

  /* MOBILE OPTIMIZATION: 2x2 Grid */
  @media (max-width: 768px) {
    .schedule-section { padding: 60px 0; }
    .desktop-only { display: none !important; }
    .timeline-main-line { display: none; }
    
    .timeline-items-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .glass-premium {
      padding: 16px 12px;
    }

    .card-time { font-size: 18px; }
    .card-label { font-size: 12px; }
    .section-title { font-size: 28px; }
  }
</style>
