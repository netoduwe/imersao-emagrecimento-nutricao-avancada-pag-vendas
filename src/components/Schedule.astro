---
interface Props {
  variant?: 'green' | 'blue';
}

const { variant = 'green' } = Astro.props;
const accentColor = variant === 'green' ? '#16A34A' : '#2563EB';

const timeline = [
  { time: "09:00", label: "Início", icon: "🚀" },
  { time: "12:00", label: "Almoço", icon: "🍴" },
  { time: "13:30", label: "Retorno", icon: "📚" },
  { time: "17:30", label: "Encerramento*", icon: "✨" }
];
---

<section id="cronograma" class={`schedule-section ${variant}`}>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Cronograma da Imersão</h2>
      <p class="section-subtitle">Uma jornada completa de atualização e prática clínica</p>
    </div>

    <div class="timeline-container-v4">
      <!-- Horizontal Line -->
      <div class="timeline-main-line"></div>

      <div class="timeline-items-grid">
        {timeline.map((item) => (
          <div class="timeline-item-v4">
            <!-- Node -->
            <div class="node-wrapper">
              <div class="timeline-node"></div>
              <div class="dotted-connector"></div>
            </div>

            <!-- Card -->
            <div class="schedule-card-v4">
              <div class="card-icon">{item.icon}</div>
              <div class="card-time">{item.time}</div>
              <div class="card-divider"></div>
              <div class="card-label">{item.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-note">
      <span class="info-icon">ℹ️</span>
      <p>*Considere encerrar mais tarde, caso os participantes peçam para nos aprofundarmos em algum ponto.</p>
    </div>
  </div>
</section>

<style define:vars={{ accentColor }}>
  .schedule-section {
    padding: 100px 0;
    background-color: #030712; /* Dark background to make glassmorphism pop like the reference */
    color: white;
    overflow: hidden;
  }

  .schedule-section.green {
    background-color: #F9FAFB;
    color: #111827;
  }

  .section-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-size: 16px;
    color: #9CA3AF;
  }

  .timeline-container-v4 {
    position: relative;
    padding-top: 40px;
    margin-bottom: 60px;
  }

  /* Horizontal Line */
  .timeline-main-line {
    position: absolute;
    top: 40px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 1;
  }

  .schedule-section.green .timeline-main-line {
    background: rgba(0, 0, 0, 0.05);
  }

  .timeline-items-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
    z-index: 2;
  }

  .timeline-item-v4 {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Node and Connector */
  .node-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 30px;
  }

  .timeline-node {
    width: 14px;
    height: 14px;
    background: var(--accentColor);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--accentColor);
  }

  .dotted-connector {
    width: 1px;
    height: 40px;
    border-left: 1px dotted rgba(255, 255, 255, 0.3);
    margin-top: 4px;
  }

  .schedule-section.green .dotted-connector {
    border-color: rgba(0, 0, 0, 0.1);
  }

  /* Schedule Card */
  .schedule-card-v4 {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 24px;
    width: 180px;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .schedule-section.green .schedule-card-v4 {
    background: white;
    border-color: #F3F4F6;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }

  .schedule-card-v4:hover {
    transform: translateY(-5px);
  }

  .card-icon {
    font-size: 20px;
    margin-bottom: 12px;
    opacity: 0.8;
  }

  .card-time {
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .card-divider {
    width: 30px;
    height: 2px;
    background: var(--accentColor);
    margin: 0 auto 12px;
    border-radius: 99px;
  }

  .card-label {
    font-size: 14px;
    font-weight: 600;
    color: #9CA3AF;
  }

  .schedule-section.green .card-label {
    color: #6B7280;
  }

  /* Footer Note */
  .footer-note {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    color: #6B7280;
    font-size: 13px;
    margin-top: 40px;
  }

  .info-icon { font-size: 16px; opacity: 0.6; }

  @media (max-width: 768px) {
    .timeline-main-line { display: none; }
    .timeline-items-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .timeline-item-v4 {
      flex-direction: row;
      gap: 20px;
      align-items: flex-start;
      padding-left: 20px;
    }
    .node-wrapper { margin-bottom: 0; }
    .dotted-connector { height: 100px; }
    .schedule-card-v4 { width: 100%; text-align: left; }
    .card-divider { margin: 0 0 12px 0; }
  }
</style>
