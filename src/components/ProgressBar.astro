---
/**
 * ProgressBar.astro
 * Barra de progresso premium de lotes da Imersão.
 * 
 * Props:
 *   variant: 'hero' | 'pricing' | 'minimal' (default: 'pricing')
 *   theme: 'green' | 'red' (default: 'green')
 */
import { IMERSAO_5ED_CURRENT_LOT } from '../config/imersao-5ed';

const { variant = 'pricing', theme = 'green' } = Astro.props;
const isHero = variant === 'hero';
const isMinimal = variant === 'minimal';
const currentLot = IMERSAO_5ED_CURRENT_LOT;
---

<div
  class={`lote-tracker ${isHero ? 'lote-tracker--hero' : ''} ${isMinimal ? 'lote-tracker--minimal' : 'lote-tracker--pricing'}`}
  data-lote-tracker
  data-theme={theme}
  data-lot-name={currentLot.labelUpper}
  data-lot-price={currentLot.basicPrice}
  data-lot-start={currentLot.startsAt}
  data-lot-end={currentLot.endsAt}
>
  <div class="lote-tracker__inner">
    {!isMinimal && (
      <div class="lote-tracker__top">
        <div class="lote-tracker__badge-wrap">
          <span class="lote-tracker__fire">🔥</span>
          <span class="lote-tracker__badge" data-lote-badge>{currentLot.labelUpper}</span>
        </div>
        <div class="lote-tracker__price-wrap">
          <span class="lote-tracker__price-label">por apenas</span>
          <span class="lote-tracker__price" data-lote-price>{currentLot.basicPrice}</span>
        </div>
      </div>
    )}

    <div class="lote-tracker__bar-outer">
      <div class="lote-tracker__bar-fill" data-lote-fill style="width: 0%">
        <div class="lote-tracker__bar-glow"></div>
      </div>
    </div>

    <div class="lote-tracker__bottom">
      <span class="lote-tracker__pct" data-lote-pct>0% vendidos</span>
      <span class="lote-tracker__remaining" data-lote-remaining>100 restantes</span>
    </div>
  </div>
</div>

<style>
  .lote-tracker {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  .lote-tracker--hero {
    margin-top: 1.5rem;
  }

  .lote-tracker--pricing {
    margin-bottom: 2.5rem;
  }

  .lote-tracker--minimal .lote-tracker__inner {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .lote-tracker__inner {
    background: var(--color-surface);
    border: 1px solid rgba(var(--color-primary-rgb, 37, 99, 235), 0.2);
    border-radius: 16px;
    padding: 1.25rem 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  /* Top row */
  .lote-tracker__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.875rem;
    gap: 12px;
  }

  .lote-tracker__badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .lote-tracker__fire {
    font-size: 1.125rem;
    animation: pulse-fire 1.5s ease-in-out infinite;
  }

  @keyframes pulse-fire {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }

  .lote-tracker__badge {
    background: var(--color-primary);
    color: white;
    padding: 0.3rem 0.875rem;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  [data-theme="red"] .lote-tracker__badge {
    background: #dc2626;
  }

  .lote-tracker__price-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    min-width: 0;
  }

  .lote-tracker__price-label {
    font-size: 0.6rem;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .lote-tracker__price {
    font-size: 1.375rem;
    font-weight: 900;
    color: var(--color-text);
    line-height: 1;
    white-space: nowrap;
  }

  /* Progress bar */
  .lote-tracker__bar-outer {
    width: 100%;
    height: 8px;
    background: rgba(0,0,0,0.05);
    border-radius: 100px;
    overflow: hidden;
    position: relative;
    contain: paint;
  }

  .lote-tracker--minimal .lote-tracker__bar-outer {
    height: 10px;
  }

  .lote-tracker__bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #22c55e 0%, #16a34a 100%);
    border-radius: 100px;
    transition: width 2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    min-width: 8px;
  }

  .lote-tracker__bar-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
    animation: shimmer 2.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }

  /* Bottom row */
  .lote-tracker__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.625rem;
    gap: 8px;
  }

  .lote-tracker__pct, .lote-tracker__remaining {
    font-size: 0.85rem;
    font-weight: 600;
    color: #4b5563;
    white-space: nowrap;
  }

  .lote-tracker--minimal .lote-tracker__remaining {
    color: #9ca3af;
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .lote-tracker__inner {
      padding: 1rem;
    }
    .lote-tracker--minimal .lote-tracker__inner {
      padding: 0;
    }
    .lote-tracker__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
    .lote-tracker__pct,
    .lote-tracker__remaining {
      font-size: 0.75rem;
      white-space: normal;
    }
  }
</style>

<script>
  function updateAllTrackers() {
    const now = new Date().getTime();

    const trackers = document.querySelectorAll('[data-lote-tracker]');
    trackers.forEach(tracker => {
      const element = tracker as HTMLElement;
      const lotName = element.dataset.lotName || 'LOTE ATUAL';
      const lotPrice = element.dataset.lotPrice || '';
      const lotStart = new Date(element.dataset.lotStart || '').getTime();
      const lotEnd = new Date(element.dataset.lotEnd || '').getTime();
      const totalDuration = lotEnd - lotStart;
      const elapsed = now - lotStart;

      let percent = 65;
      if (elapsed > 0 && totalDuration > 0) {
        const calculatedPct = 65 + (34 * (elapsed / totalDuration));
        percent = Math.min(Math.max(calculatedPct, 65), 99);
      }

      const visualPercent = Math.min(percent, 100);
      const badge = tracker.querySelector('[data-lote-badge]');
      const price = tracker.querySelector('[data-lote-price]');
      const fill = tracker.querySelector('[data-lote-fill]') as HTMLElement;
      const pct = tracker.querySelector('[data-lote-pct]');
      const remaining = tracker.querySelector('[data-lote-remaining]');

      if (badge) badge.textContent = lotName;
      if (price) price.textContent = lotPrice;
      if (fill) {
        fill.style.width = `${Math.max(visualPercent, 5)}%`;
        
        // Troca dinâmica de cor (ou força se for red)
        if (tracker.getAttribute('data-theme') === 'red') {
          fill.style.background = 'linear-gradient(90deg, #dc2626 0%, #991b1b 100%)';
        } else if (visualPercent > 90) {
          fill.style.background = 'linear-gradient(90deg, #ef4444 0%, #b91c1c 100%)'; // Vermelho
        } else if (visualPercent > 70) {
          fill.style.background = 'linear-gradient(90deg, #f59e0b 0%, #d97706 100%)'; // Laranja
        } else {
          fill.style.background = 'linear-gradient(90deg, #22c55e 0%, #16a34a 100%)'; // Verde
        }
      }
      
      if (pct) pct.textContent = `${Math.floor(percent)}% dos ingressos vendidos`;

      // Contador regressivo para virada do lote
      const diff = lotEnd - now;
      if (remaining) {
        if (diff > 0) {
          const d = Math.floor(diff / (1000 * 60 * 60 * 24));
          const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const s = Math.floor((diff % (1000 * 60)) / 1000);
          remaining.textContent = `Encerramento em: ${d}d ${h}h ${m}m ${s}s`;
        } else {
          remaining.textContent = `Vagas Limitadas`;
        }
      }
    });
  }

  updateAllTrackers();
  setInterval(updateAllTrackers, 1000); // atualiza a cada segundo para o countdown rodar ao vivo
</script>
