---
/**
 * FormModal.astro
 * Modal com iframe do formulário GHL (pre-checkout).
 */
---

<div id="form-modal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <button class="modal-close" id="modal-close" aria-label="Fechar">&times;</button>
    <iframe
      id="modal-iframe"
      src=""
      style="width:100%;height:380px;border:none;display:block;"
      title="Formulário de Ingresso"
    ></iframe>
    <div id="form-loading" class="form-loading" role="status" aria-live="polite">
      <span class="form-loading-spinner" aria-hidden="true"></span>
      <span>Carregando inscrição...</span>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
  }

  .modal-content {
    background: var(--color-surface);
    border-radius: 12px;
    width: 90%;
    max-width: 450px;
    position: relative;
    padding: 1.5rem;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.3s ease;
    border: 1px solid rgba(255,255,255,0.05);
  }

  .modal-content iframe {
    border-radius: 8px;
  }

  .modal-content iframe.is-hydrating {
    opacity: 0;
    pointer-events: none;
  }

  .form-loading {
    position: absolute;
    inset: 1.5rem;
    display: none;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    min-height: 380px;
    color: var(--color-text, #17201c);
    font-size: .95rem;
    background: var(--color-surface, #fff);
    border-radius: 8px;
  }

  .form-loading.is-visible { display: flex; }

  .form-loading-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(0, 0, 0, .14);
    border-top-color: var(--color-primary, #15966a);
    border-radius: 50%;
    animation: formSpin .8s linear infinite;
  }

  @keyframes formSpin { to { transform: rotate(360deg); } }

  .modal-close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    border: 2px solid var(--color-surface);
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.2s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }

  .modal-close:hover {
    transform: scale(1.1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>

<script>
  const FORMS = {
    normal: 'https://links.fullfunnel.app/widget/form/Z1AkP8zQTM494tXR8loP',
    vip: 'https://links.fullfunnel.app/widget/form/XuSUwksfyVTSPoPKdMe8'
  };

  const modal = document.getElementById('form-modal');
  const iframe = document.getElementById('modal-iframe') as HTMLIFrameElement;
  const loading = document.getElementById('form-loading');
  const closeBtn = document.getElementById('modal-close');
  let hydrationTimer: number | undefined;

  function beginHydration() {
    if (hydrationTimer) window.clearTimeout(hydrationTimer);
    iframe.classList.add('is-hydrating');
    loading?.classList.add('is-visible');
    modal?.setAttribute('aria-busy', 'true');
  }

  function finishHydration() {
    iframe.classList.remove('is-hydrating');
    loading?.classList.remove('is-visible');
    modal?.setAttribute('aria-busy', 'false');
  }

  iframe.addEventListener('load', () => {
    if (!iframe.src) return;
    // O FullFunnels hidrata campos recebidos pela query string de forma assíncrona.
    hydrationTimer = window.setTimeout(finishHydration, 4500);
  });

  function buildTrackedFormUrl(baseUrl: string) {
    const formUrl = new URL(baseUrl);
    const currentParams = new URLSearchParams(window.location.search);

    currentParams.forEach((value, key) => {
      if (value) formUrl.searchParams.set(key, value);
    });

    const savedAttribution = (window as any).T9Tracking?.attribution || {};
    Object.entries(savedAttribution).forEach(([key, value]) => {
      if (value && !formUrl.searchParams.has(key)) formUrl.searchParams.set(key, String(value));
    });

    const sessionId = (window as any).T9Tracking?.sessionId;
    if (sessionId) formUrl.searchParams.set('t9_session_id', sessionId);

    return formUrl.toString();
  }

  // Abrir modal
  document.querySelectorAll('[data-form]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const type = (btn as HTMLElement).dataset.form;
      const formUrl = type ? FORMS[type as keyof typeof FORMS] : undefined;

      if (formUrl) {
        beginHydration();
        iframe.src = buildTrackedFormUrl(formUrl);
        modal!.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        window.dispatchEvent(new CustomEvent('t9:form-open', {
          detail: { ticket_type: type === 'vip' ? 'vip' : 'basic' }
        }));
      }
    });
  });

  // Fechar modal
  function closeModal() {
    if (hydrationTimer) window.clearTimeout(hydrationTimer);
    modal!.style.display = 'none';
    iframe.src = '';
    finishHydration();
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
