  <FormModal />
</Layout>

<script>
  // Script para animar as barras de progresso dos 4 pilares conforme entram na tela
  const pilarCards = document.querySelectorAll('.pilar-card');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bar = entry.target.querySelector('.pilar-progress-fill');
        if (bar) {
          (bar as HTMLElement).style.width = '100%';
        }
      }
    });
  }, { threshold: 0.3 });

  pilarCards.forEach(card => observer.observe(card));
</script>
