---
import Layout from '../layouts/Layout.astro';
import FormModal from '../components/FormModal.astro';
import T9Tracking from '../components/T9Tracking.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { IMERSAO_5ED_CURRENT_LOT, IMERSAO_5ED_PRICING } from '../config/imersao-5ed';
import '../styles/theme-green.css';

// Dados do evento
const EVENT_DATE = '01 de Agosto de 2026';
const EVENT_DATE_SHORT = '01 Ago 2026';
const EVENT_TIME = '9h às 18h';
const EVENT_FORMAT = 'Zoom';
const LOTE = IMERSAO_5ED_CURRENT_LOT.label;
const LOTE_UPPER = IMERSAO_5ED_CURRENT_LOT.labelUpper;
const PRICE_BASICO = IMERSAO_5ED_CURRENT_LOT.basicPrice;
const PRICE_VIP = IMERSAO_5ED_PRICING.vipCash;
---

<Layout title={`Imersão em Emagrecimento — 5ª Edição | ${EVENT_DATE} | Nutrição Avançada`} theme="green">

  <!-- ══════════════════════════════════════
       HERO V2 — REFERENCE INSPIRED STYLE (LIGHT BG TO BLEND PERFECTLY WITH NEY'S FACE)
       ══════════════════════════════════════ -->
  <section class="hero-v2-section" id="imersao">
    <div class="container hero-v2-grid">
      <!-- LEFT COLUMN -->
      <div class="hero-v2-content">
        
        <!-- Header Info Group (Date pill style from print 01 with border) -->
        <div class="hero-v2-header-group">
          <!-- Date Pill (From print 01 style - High contrast on light background) -->
          <div class="info-bar">
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="calendar-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span>{EVENT_DATE_SHORT}</span>
            </div>
            <div class="info-sep"></div>
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>{EVENT_TIME}</span>
            </div>
            <div class="info-sep"></div>
            <div class="info-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"></path><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
              <span>{EVENT_FORMAT}</span>
            </div>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="hero-v2-headline">
          Um dia inteiro aprendendo a <span class="h-green">tratar o emagrecimento</span> com o que a ciência mais atual comprova.
        </h1>

        <!-- Subheadline -->
        <p class="hero-v2-sub">
          Manejo de canetas emagrecedoras, compostos bioativos e prática clínica além do déficit calórico — com Ney Felipe e Jéssica Wszolek.
        </p>

        <!-- Price Box (EXACTLY matching Image 3 reference with cohesive stack and 380px size) -->
        <div class="hero-v2-price-container">
          <div class="hero-v2-price-card">
            <!-- Badge overlapping the border -->
            <span class="price-card-badge">{LOTE}</span>
            
            <div class="price-card-old">
              De <span class="strikethrough">R$ 97,00</span> por apenas:
            </div>
            <div class="price-card-main">{PRICE_BASICO}</div>
          </div>

          <a href="#preco" class="btn-v2-hero">
            Pegar meu ingresso! <span class="btn-v2-arrow">&lt;</span>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN (Empty, keeps background clear of grey masks so Ney's face looks perfectly clean) -->
      <div class="hero-v2-right"></div>
    </div>


  </section>

  <!-- ══════════════════════════════════════
       PROBLEMA — DOR DO NUTRICIONISTA
       ══════════════════════════════════════ -->
  <section class="section-problema" id="conteudo">
    <div class="container problema-grid">
      <div class="problema-text">
        <h2 class="section-title">Você se sente seguro para tratar um paciente com sobrepeso?</h2>
        <p class="section-sub">Com certeza você já enfrentou situações como essas no consultório:</p>

        <ul class="dor-list">
          <li>
            <span class="dor-x">✓</span>
            <span>Paciente não adere ao plano alimentar e você não sabe por quê</span>
          </li>
          <li>
            <span class="dor-x">✓</span>
            <span>Insegurança para conduzir a consulta além das calorias</span>
          </li>
          <li>
            <span class="dor-x">✓</span>
            <span>Não sabe como periodizar o acompanhamento corretamente</span>
          </li>
          <li>
            <span class="dor-x">✓</span>
            <span>Desatualizado sobre canetas emagrecedoras (GLP-1) e compostos bioativos</span>
          </li>
          <li>
            <span class="dor-x">✓</span>
            <span>Dificuldade para manejar pacientes pós-medicação sem recaída</span>
          </li>
          <li>
            <span class="dor-x">✓</span>
            <span>Falta de ferramentas práticas para a consulta de emagrecimento</span>
          </li>
        </ul>
      </div>

      <div class="problema-quote-side">
        <blockquote class="problema-blockquote">
          <p>"Embora o déficit calórico seja a condição <em>sine qua non</em> para emagrecer, <strong>a nutrição não se resume a uma simples calculoterapia.</strong>"</p>
          <footer>— Ney Felipe</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       MANCHETES — OPORTUNIDADE DO MERCADO (OZEMPIC & OBESIDADE)
       ══════════════════════════════════════ -->
  <section class="section-manchetes">
    <div class="container text-center">
      <h2 class="section-title">O mercado mudou. Quem não se atualizar, ficará para trás.</h2>
      <p class="section-sub" style="max-width: 700px; margin: 0 auto 20px;">
        As canetas emagrecedoras e a nova realidade da obesidade abriram uma oportunidade sem precedentes para nutricionistas que dominam a clínica avançada:
      </p>
      
      <div class="news-clippings-container">
        
        <div class="news-clipping-card card-rotate-left">
          <div class="news-source">GOOGLE TRENDS & LEVANTAMENTO GLOBAL</div>
          <div class="news-date">Volume de buscas recorde</div>
          <h3 class="news-title">
            Brasil ocupa a <mark class="news-highlight">2ª posição mundial nas buscas por Ozempic e Mounjaro</mark> na internet.
          </h3>
          <p class="news-excerpt">
            A procura massiva por canetas emagrecedoras movimentou mais de R$ 10 bilhões no mercado nacional, gerando uma onda inédita de pacientes necessitando de suporte nutricional no consultório.
          </p>
        </div>

        <div class="news-clipping-card card-rotate-right">
          <div class="news-source">ESTUDOS DE MUNDO REAL (GLP-1)</div>
          <div class="news-date">Adesão e Efeitos Colaterais</div>
          <h3 class="news-title">
            Mais de <mark class="news-highlight">45% dos pacientes abandonam o uso de canetas de GLP-1</mark> no primeiro ano.
          </h3>
          <p class="news-excerpt">
            Os principais motivos de abandono são os efeitos gastrointestinais severos e a perda de massa magra. O nutricionista preparado é indispensável para evitar esses problemas e manter o resultado.
          </p>
        </div>

        <div class="news-clipping-card card-rotate-straight">
          <div class="news-source">ORGANIZAÇÃO MUNDIAL DA SAÚDE</div>
          <div class="news-date">Projeções Epidemiológicas</div>
          <h3 class="news-title">
            Projeções alertam que até 2030, cerca de <mark class="news-highlight">68% dos brasileiros estarão com excesso de peso</mark>.
          </h3>
          <p class="news-excerpt">
            O avanço do sobrepeso exige condutas clínicas modernas. Tratar emagrecimento apenas calculando déficit calórico básico faliu, abrindo espaço para a nutrição baseada em fisiologia real.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       MECANISMO — POR QUE ESSA IMERSÃO FUNCIONA
       ══════════════════════════════════════ -->
  <section class="section-mecanismo">
    <div class="container mecanismo-inner">
      <h2 class="section-title text-center">Por que uma imersão de 1 dia muda sua prática clínica?</h2>
      <p class="section-sub text-center" style="max-width:680px;margin:0 auto 48px;">
        Não é mais um curso de teoria. É um dia inteiro de imersão aplicada, com casos clínicos reais, ferramentas práticas e os protocolos que o Ney usa depois de 19 anos de consultório.
      </p>

      <div class="mecanismo-grid">
        <div class="mec-card">
          <div class="mec-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3>Imersão, não curso</h3>
          <p>9h de conteúdo intenso com profundidade real — não aulas gravadas que você esquece na semana seguinte.</p>
        </div>
        <div class="mec-card">
          <div class="mec-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3>Prática clínica aplicada</h3>
          <p>Cada bloco termina com como aplicar amanhã na consulta — da conduta ao manejo de expectativas do paciente.</p>
        </div>
        <div class="mec-card">
          <div class="mec-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Ciência atualizada</h3>
          <p>GLP-1, canetas emagrecedoras, compostos bioativos e neurofisiologia do comportamento — o que a literatura mais recente comprova.</p>
        </div>
        <div class="mec-card">
          <div class="mec-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Especialistas de alto nível</h3>
          <p>Ney Felipe + Jéssica Wszolek — dois especialistas com vivência real nos temas que mais impactam o tratamento do sobrepeso hoje.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       TIME / PALESTRANTES
       ══════════════════════════════════════ -->
  <section class="section-professores" id="time">
    <div class="container">
      <h2 class="section-title text-center">Quem estará no palco virtual?</h2>
      <p class="section-sub text-center" style="max-width: 600px; margin: 0 auto 48px;">
        Aprenda com quem está no campo de batalha clínico diariamente.
      </p>

      <div class="professores-grid">
        <!-- Ney -->
        <div class="professor-card">
          <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" class="prof-photo" />
          <div class="prof-info">
            <h3>NEY FELIPE</h3>
            <span class="prof-tag">Nutricionista e Mestre em Biol. Molecular</span>
            <p>Pioneiro da Nutrição Funcional Esportiva no Brasil, atua há 19 anos em consultório ajudando milhares de pacientes e profissionais.</p>
          </div>
        </div>

        <!-- Jéssica -->
        <div class="professor-card">
          <img src="/images/jessica.webp" alt="Jéssica Wszolek" class="prof-photo" />
          <div class="prof-info">
            <h3>JÉSSICA WSZOLEK</h3>
            <span class="prof-tag">Professora Convidada</span>
            <p>Especialista e referência em manejo dietético integrado ao uso de análogos de GLP-1 e modulação do emagrecimento.</p>
            <a href="https://www.youtube.com/shorts/vPnW2rWVQHY" target="_blank" class="btn-ver-chamada">
              🎥 VER CHAMADA
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       GRADE DE CONTEÚDO
       ══════════════════════════════════════ -->
  <section class="section-grade">
    <div class="container">
      <h2 class="section-title text-center">Cronograma da Imersão</h2>
      <p class="section-sub text-center" style="max-width: 500px; margin: 0 auto 32px;"> Ambos os blocos do dia seguirão essa divisão de horários:</p>

      <div class="grade-timeline">
        <div class="grade-block">
          <div class="grade-time">09h30</div>
          <div class="grade-line">
            <div class="grade-dot"></div>
            <div class="grade-connector"></div>
          </div>
          <div class="grade-card">
            <h3>Início do Evento</h3>
            <p>Boas-vindas e abertura da transmissão ao vivo via Zoom.</p>
          </div>
        </div>

        <div class="grade-block">
          <div class="grade-time">12h00</div>
          <div class="grade-line">
            <div class="grade-dot grade-dot-break"></div>
            <div class="grade-connector"></div>
          </div>
          <div class="grade-card grade-card-break">
            <h3>Intervalo para Almoço</h3>
            <p>Momento de pausa para almoço e descanso.</p>
          </div>
        </div>

        <div class="grade-block">
          <div class="grade-time">13h30</div>
          <div class="grade-line">
            <div class="grade-dot"></div>
            <div class="grade-connector"></div>
          </div>
          <div class="grade-card">
            <h3>Retorno das Palestras</h3>
            <p>Reinício dos blocos técnicos de conteúdo prático.</p>
          </div>
        </div>

        <div class="grade-block">
          <div class="grade-time">17h30</div>
          <div class="grade-line">
            <div class="grade-dot grade-dot-both"></div>
          </div>
          <div class="grade-card">
            <h3>Encerramento das Atividades*</h3>
            <p style="font-size: 12px; color: var(--text-muted); font-style: italic; margin-top: 4px;">
              *Considere encerrar mais tarde, caso os participantes peçam para nos aprofundarmos em algum ponto. Porém, o conteúdo combinado será entregue dentro do horário programado.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CONTEÚDO DETALHADO (MÓDULOS DE VERDADE FORA DA TIME-LINE)
       ══════════════════════════════════════ -->
  <section class="section-modulos-detalhes" id="grade-conteudo">
    <div class="container">
      <h2 class="section-title text-center">O Que Você Vai Aprender</h2>
      <p class="section-sub text-center" style="max-width: 600px; margin: 0 auto 40px;">
        Todo o raciocínio clínico e as condutas de consultório estruturadas:
      </p>

      <div class="modulos-grid-split">
        
        <!-- Ney Felipe Column -->
        <div class="modulo-col">
          <div class="modulo-col-header green-header">
            <h3>Conduta Clínica & Emagrecimento</h3>
            <span class="prof-name">Prof. Ney Felipe</span>
          </div>
          <ul class="modulo-col-bullets">
            <li>Como conduzir o paciente durante os períodos críticos do emagrecimento (adesão, platô e reganho).</li>
            <li>Os alvos moleculares que o nutricionista precisa priorizar no acompanhamento nutricional.</li>
            <li>Como parar de tratar emagrecimento apenas como “déficit calórico”.</li>
            <li>Como montar uma proposta terapêutica de emagrecimento que vai além das calorias.</li>
            <li>Como realmente aplicar os alimentos funcionais e compostos bioativos para emagrecimento (sem shot de cúrcuma e manipulados fakes).</li>
            <li>Como aplicar a dieta mediterrânea no emagrecimento de forma prática, estratégica e individualizada.</li>
            <li>Estudo de caso: como desenhar, passo a passo, uma proposta terapêutica para o paciente que busca emagrecimento.</li>
            <li>O Método Nutrição Avançada baseado em evidências para acompanhar o paciente em todas as fases do emagrecimento.</li>
          </ul>
        </div>

        <!-- Jessica Wszolek Column -->
        <div class="modulo-col">
          <div class="modulo-col-header purple-header">
            <h3>Manejo Prático de GLP-1</h3>
            <span class="prof-name">Profa. Jéssica Wszolek</span>
          </div>
          <ul class="modulo-col-bullets">
            <li>Por que as “canetas emagrecedoras” não eliminam o nutricionista… elas tornam o nutricionista ainda mais indispensável.</li>
            <li>O erro silencioso que faz o paciente emagrecer na balança, mas perder massa magra no processo — e como evitar isso na prática clínica.</li>
            <li>Como ajustar a dieta de um paciente em uso de GLP-1 quando o apetite simplesmente desaparece — sem deixar a proteína e os micronutrientes irem junto.</li>
            <li>O que NUNCA ignorar em um paciente que usa GLP-1 se você quer evitar fadiga, déficit proteico e queda de desempenho no treino.</li>
            <li>Por que o desmame da medicação começa muito antes da retirada da caneta — e qual o papel do nutricionista nesse processo.</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       DEPOIMENTOS & PESQUISA DE SATISFAÇÃO (CRO)
       ══════════════════════════════════════ -->
  <section class="section-depos">
    <div class="container">
      <h2 class="section-title text-center">Resultados e Avaliação da Última Edição</h2>
      <p class="section-sub text-center" style="max-width: 600px; margin: 0 auto 40px;">
        Veja a opinião real e avaliação de quem participou da edição anterior.
      </p>

      <!-- Stat card for Google Forms results with modern premium styling -->
      <div class="satisfaction-metrics-block">
        <div class="stat-main-card">
          <div class="stat-percentage">70.1%</div>
          <div class="stat-desc">
            <h3>"Superou muito minhas expectativas"</h3>
            <p>De acordo com a pesquisa de avaliação pós-evento respondida por <strong>174 participantes</strong> da última edição da Imersão.</p>
            
            <div class="stat-chart-container">
              <div class="stat-bar-item">
                <span class="bar-label">Superou muito minhas expectativas (70.1%)</span>
                <div class="bar-track">
                  <div class="bar-fill-actual" style="width: 70.1%; background: #16A34A;"></div>
                </div>
              </div>
              <div class="stat-bar-item">
                <span class="bar-label">Atendeu minhas expectativas (29.3%)</span>
                <div class="bar-track">
                  <div class="bar-fill-actual" style="width: 29.3%; background: #0A6591;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Real Screenshots from drive (Authentic proof - larger and modal clickable) -->
      <div class="real-screenshots-block">
        <h3 class="section-subtitle-small text-center">Mensagens reais dos participantes (Clique para ampliar e ler)</h3>
        <div class="screenshots-grid">
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_1.png">
            <img src="/images/depoimentos/Screenshot_1.png" alt="Depoimento 1" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>

          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_3.png">
            <img src="/images/depoimentos/Screenshot_3.png" alt="Depoimento 3" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_14.png">
            <img src="/images/depoimentos/Screenshot_14.png" alt="Depoimento 4" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_23.png">
            <img src="/images/depoimentos/Screenshot_23.png" alt="Depoimento 5" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Testimonial quotes Grid -->
      <div class="depos-grid">
        <div class="depo-card">
          <div class="stars">★★★★★</div>
          <p class="depo-text">"Me sinto muito mais segura nas abordagens. Pego um paciente e sei o que fazer com ele em todas as fases com segurança."</p>
          <div class="depo-author">
            <img src="https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-02.png" alt="Nair Cristina" class="depo-avatar" />
            <div>
              <div class="depo-name">Nair Cristina</div>
              <div class="depo-role">Nutricionista há 4 anos</div>
            </div>
          </div>
        </div>

        <div class="depo-card">
          <div class="stars">★★★★★</div>
          <p class="depo-text">"Nos primeiros atendimentos após o curso pude me notar menos 'calculadora' e mais nutricionista, dando um novo significado às minhas consultas."</p>
          <div class="depo-author">
            <img src="https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-04.png" alt="Melissa Pinheiro" class="depo-avatar" />
            <div>
              <div class="depo-name">Melissa Pinheiro</div>
              <div class="depo-role">Nutricionista há 10 anos</div>
            </div>
          </div>
        </div>

