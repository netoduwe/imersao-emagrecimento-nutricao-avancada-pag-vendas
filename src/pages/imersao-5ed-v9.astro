  <script>
    const target = new Date('2026-08-01T09:00:00-03:00').getTime();
    const fields = {
      days: document.getElementById('v9-days'),
      hours: document.getElementById('v9-hours'),
      minutes: document.getElementById('v9-minutes'),
      seconds: document.getElementById('v9-seconds')
    };

    function updateV9Countdown() {
      const distance = Math.max(0, target - Date.now());
      const days = Math.floor(distance / 86400000);
      const hours = Math.floor((distance % 86400000) / 3600000);
      const minutes = Math.floor((distance % 3600000) / 60000);
      const seconds = Math.floor((distance % 60000) / 1000);

      if (fields.days) fields.days.textContent = String(days).padStart(2, '0');
      if (fields.hours) fields.hours.textContent = String(hours).padStart(2, '0');
      if (fields.minutes) fields.minutes.textContent = String(minutes).padStart(2, '0');
      if (fields.seconds) fields.seconds.textContent = String(seconds).padStart(2, '0');
    }

    updateV9Countdown();
    window.setInterval(updateV9Countdown, 1000);

    const mobileCta = document.querySelector('.v9-mobile-cta');
    const ticketsSection = document.querySelector('#ingressos');

    function updateV9MobileCta() {
      if (!mobileCta) return;
      const ticketsRect = ticketsSection?.getBoundingClientRect();
      const ticketsInView = ticketsRect ? ticketsRect.top < window.innerHeight * 0.8 && ticketsRect.bottom > 80 : false;
      const shouldShow = window.scrollY > window.innerHeight * 0.9 && !ticketsInView;
      mobileCta.classList.toggle('is-visible', shouldShow);
    }

    updateV9MobileCta();
    window.addEventListener('scroll', updateV9MobileCta, { passive: true });
    window.addEventListener('hashchange', updateV9MobileCta);
  </script>
</Layout>
