---
import Layout from '../layouts/Layout.astro';
import FormModal from '../components/FormModalV7.astro';
import T9Tracking from '../components/T9Tracking.astro';
import { IMERSAO_5ED_CURRENT_LOT, IMERSAO_5ED_PRICING } from '../config/imersao-5ed';
import '../styles/imersao-v9.css';

const EVENT_DATE = '01 de Agosto de 2026';
const EVENT_TIME = '9h às 18h';
const LOTE = IMERSAO_5ED_CURRENT_LOT.label;
const LOTE_UPPER = IMERSAO_5ED_CURRENT_LOT.labelUpper;
const PRICE_BASIC = IMERSAO_5ED_CURRENT_LOT.basicPrice;
const PRICE_VIP_INSTALLMENTS = IMERSAO_5ED_PRICING.vipInstallments;
const PRICE_VIP_INSTALLMENT_VALUE = IMERSAO_5ED_PRICING.vipInstallmentValue;
const PRICE_VIP_CASH = IMERSAO_5ED_PRICING.vipCash;
---

<Layout
  title={`Imersão em Emagrecimento e GLP-1 | ${EVENT_DATE}`}
  theme="green"
  hideHeader={true}
  hideUrgency={true}
  hideChatbase={true}
>
  <div class="white-page v9-page">
    <div class="event-countdown" aria-label="Contagem regressiva para a imersão">
      <div class="white-shell event-countdown__inner">
        <div class="event-countdown__title">
          <span class="event-countdown__clock" aria-hidden="true"></span>
          <strong><span class="event-countdown__desktop-label">Imersão começa em:</span><span class="event-countdown__mobile-label">Começa em</span></strong>
        </div>
        <div class="event-countdown__units" aria-live="polite">
          <span><b id="v9-days">00</b><small>Dias</small></span>
          <span><b id="v9-hours">00</b><small>Horas</small></span>
          <span><b id="v9-minutes">00</b><small>Minutos</small></span>
          <span><b id="v9-seconds">00</b><small>Segundos</small></span>
        </div>
        <a href="#ingressos" class="event-countdown__button">Ver ingressos <span>→</span></a>
      </div>
    </div>

    <section class="white-hero" id="inicio">
      <div class="white-shell white-hero__inner">
        <p class="white-hero__date">
