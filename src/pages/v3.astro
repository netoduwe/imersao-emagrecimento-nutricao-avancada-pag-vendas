---
import Layout from '../layouts/Layout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import FormModal from '../components/FormModal.astro';
import Schedule from '../components/Schedule.astro';
import VideoRecado from '../components/VideoRecado.astro';
import '../styles/theme-green.css';
---

<Layout title="Novo Método de Emagrecimento além das Calorias | Imersão 16/05" theme="green">

  <!-- HERO V3 — ALÉM DAS CALORIAS -->
  <section class="hero-v3">
    <div class="container hero-v3-grid">
      <div class="hero-v3-text">
        <div class="badge-row">
          <span class="badge-green">📅 16 de Maio · 9h às 18h</span>
          <span class="badge-blue"><span class="live-dot">●</span> AO VIVO · Online via <strong class="zoom">zoom</strong></span>
        </div>

        <h1 class="h1-v3">
          Aprenda um Novo Método de<br/>
          <span class="serif-green">Emagrecimento</span><br/>
          que vai além das calorias<br/>
          <span class="linha-sub">para aplicar com seus pacientes</span>
        </h1>

        <p class="sub-v3">
          Em <strong>um dia ao vivo</strong>, você vai se atualizar com a ciência mais atual — e sair com ferramentas reais para transformar suas consultas de emagrecimento.
        </p>

        <div class="urgency-v3">
          ⚠️ <strong>Últimos ingressos disponíveis</strong> — evento em 16 de Maio
        </div>

        <div class="cta-v3">
          <a href="#preco" class="btn-main-v3">
            QUERO APRENDER ALÉM DAS CALORIAS — R$ 29,90
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
          <span class="anchor">Por menos do que um café ☕</span>
        </div>

        <div class="progress-wrap"><ProgressBar variant="minimal" /></div>
      </div>
      <div class="hero-v3-visual"></div>
    </div>
  </section>

  <!-- SPOILER -->
  <div class="container">
    <div class="spoiler-v3">
      <span>🛡️</span>
      <p><strong>Spoiler:</strong> Essa não é apenas uma imersão de teoria. Você também vai aprender sobre <strong>prática clínica</strong>, manejo das canetas emagrecedoras (GLP-1) e como ir <strong>além do déficit calórico</strong>.</p>
    </div>
  </div>

  <!-- DORES -->
  <section class="container" style="padding: var(--space-xl) var(--space-sm);">
    <div class="grid-2">
      <div>
        <h2 style="margin-bottom: var(--space-md);">Você se sente seguro para transformar vidas?</h2>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;">
          <li>❌ Não soube como ir <b>além das calorias...</b></li>
          <li>❌ Não conseguiu fazer o paciente aderir...</li>
          <li>❌ Teve insegurança para conduzir a consulta...</li>
          <li>❌ Se sentiu <b>desatualizado</b> cientificamente...</li>
          <li>❌ Faltaram ferramentas de prática clínica...</li>
        </ul>
      </div>
      <div style="background:#f0fdf4;border-radius:var(--radius-lg);padding:2rem;border:1px solid #dcfce7;">
        <h3 style="color:var(--color-primary);margin-bottom:1rem;">O que você vai aprender:</h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:0.875rem;">
          <li>✅ Nutrição Funcional no Emagrecimento</li>
          <li>✅ Canetas Emagrecedoras / GLP-1</li>
          <li>✅ Epigenética, Nutrigenética e Obesidade</li>
          <li>✅ Aspectos neuroendócrinos da obesidade</li>
          <li style="margin-top: 1rem; color: var(--color-primary); font-weight: 800; font-size: 0.75rem; text-transform: uppercase;">Conteúdo da Prof. Cássia:</li>
          <li>✅ Conduzir o atendimento para reduzir abandono precoce</li>
          <li>✅ Ajustar expectativas irreais sem desmotivá-lo</li>
          <li>✅ Preparar para autonomia pós medicação injetável</li>
          <li>✅ Evitar recaídas após suspensão da medicação</li>
          <li>✅ Criar planos que o paciente consegue sustentar</li>
          <li>✅ Aumentar adesão sem força de vontade</li>
          <li>✅ Caso clínico real com estratégia completa</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BIO -->
  <section class="bio-section container grid-bio" style="padding: var(--space-xl) var(--space-sm);">
    <div class="bio-image-container">
      <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" style="width:100%;border-radius:var(--radius-lg);background:white;padding:1rem;border:1px solid rgba(0,0,0,0.05);" />
      <div style="margin-top:1.5rem;text-align:center;"><h3 style="font-size:1.5rem;color:var(--color-primary);">Ney Felipe (@neyfelipef)</h3></div>
    </div>
    <div>
      <h2 style="font-size:2.25rem;margin-bottom:var(--space-md);">Aprenda com quem está no campo de batalha há 18 anos.</h2>
      <div style="color:var(--color-text-light);line-height:1.7;display:flex;flex-direction:column;gap:1.5rem;">
        <p>Fundador da Nutrição Avançada e pioneiro da Nutrição Funcional Esportiva no Brasil. Nos últimos 4 anos formou mais de <b>3 mil Nutricionistas</b>.</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
          <li>✅ Nutricionista há 18 anos (2006)</li>
          <li>✅ Mestre em Biologia Molecular (2011)</li>
          <li>✅ Doutorando em Saúde Pública (2024)</li>
          <li>✅ Mais de 3 mil alunos formados</li>
          <li>✅ 2 livros publicados e 5 e-books</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- DEPOIMENTOS -->
  <section class="container" style="padding:var(--space-xl) var(--space-sm);">
    <h2 class="text-center" style="margin-bottom:var(--space-xl);">Resultados de quem já esteve lá</h2>
    <div class="grid-3">
      <div style="background:white;padding:var(--space-md);border-radius:var(--radius-lg);text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.03);">
        <img src="https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-02.png" alt="Nair" style="width:100px;height:100px;border-radius:50%;margin-bottom:1rem;" />
        <h4>NAIR CRISTINA</h4>
        <p class="italic">"Me sinto muito mais segura nas abordagens, eu pego um paciente e sei o que fazer com ele em todas as fases."</p>
      </div>
      <div style="background:white;padding:var(--space-md);border-radius:var(--radius-lg);text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.03);">
        <img src="https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-04.png" alt="Melissa" style="width:100px;height:100px;border-radius:50%;margin-bottom:1rem;" />
        <h4>MELISSA PINHEIRO</h4>
        <p class="italic">"Pude me notar menos 'calculadora' e mais nutricionista, dando um novo significado e brilho nas minhas consultas."</p>
      </div>
      <div style="background:white;padding:var(--space-md);border-radius:var(--radius-lg);text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.03);">
        <img src="https://nutrineyfelipe.com/wp-content/uploads/2023/09/depo-03.png" alt="Nathalia" style="width:100px;height:100px;border-radius:50%;margin-bottom:1rem;" />
        <h4>NATHALIA PANTALEÃO</h4>
        <p class="italic">"Hoje meus pacientes indicam meu trabalho."</p>
      </div>
    </div>
  </section>

  <VideoRecado />

  <Schedule variant="green" />

  <!-- PREÇOS -->
  <section id="preco" style="background:var(--color-bg);padding:var(--space-xl) var(--space-sm);">
    <div class="container">
      <h2 class="text-center" style="margin-bottom:0.5rem;">Escolha seu Ingresso</h2>
      <p class="text-center" style="color:var(--color-text-light);margin-bottom:2rem;">16 de Maio · 9h às 18h · Online via Zoom</p>
      <div class="grid-bio">
        <div style="background:white;padding:3rem;border-radius:var(--radius-lg);display:flex;flex-direction:column;border:1px solid rgba(0,0,0,0.05);">
          <h3 style="font-size:1.5rem;margin-bottom:0.5rem;">Ingresso Normal</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;flex-grow:1;margin:1.5rem 0 3rem;">
            <li>✅ Um dia de Imersão ao vivo</li>
            <li>✅ 8h de Conteúdo</li>
            <li>✅ Grupo do Evento + Materiais</li>
            <li>🎁 Mini Curso Fundamentos Emagrecimento</li>
          </ul>
          <div style="margin-bottom:1.5rem;">
            <span style="text-decoration:line-through;color:#999;">De R$97,00</span>
            <div style="font-size:2.5rem;font-weight:800;">R$ 29,90</div>
          </div>
          <a href="#" class="btn-shiny" style="width:100%;" data-form="normal">
            <span class="btn-text">COMPRAR AGORA</span>
            <div class="btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></div>
          </a>
          <div style="margin-top:1.5rem;"><ProgressBar variant="minimal" /></div>
        </div>
        <div style="background:white;padding:3rem;border-radius:var(--radius-lg);display:flex;flex-direction:column;border:2px solid var(--color-primary);position:relative;">
          <div style="position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:var(--color-primary);color:white;padding:0.5rem 1.5rem;border-radius:var(--radius-full);font-size:0.875rem;font-weight:700;">MAIS VANTAGENS</div>
          <h3 style="font-size:1.5rem;margin-bottom:0.5rem;">Ingresso VIP</h3>
          <p style="color:var(--color-primary);font-weight:700;margin-bottom:2rem;">50% DE DESCONTO</p>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;flex-grow:1;margin-bottom:3rem;">
            <li>🚀 Tudo do básico + gravação por 1 ano + certificado 8h</li>
            <li>🎁 E-book Tópicos Avançados <small>(R$99)</small></li>
            <li>🎁 E-book "Me Formei, e agora?" <small>(R$59)</small></li>
            <li>🎁 E-book Desaprendendo a Dieta <small>(R$39)</small></li>
            <li>🎓 Ressaca do Evento (encontro extra Zoom)</li>
            <li>💰 Cashback integral na Formação ou Pós</li>
          </ul>
          <div style="margin-bottom:1.5rem;">
            <span style="text-decoration:line-through;color:#999;">De R$297,00</span>
            <div style="font-size:0.875rem;color:var(--color-text-light);">POR 12x DE:</div>
            <div style="font-size:2.5rem;font-weight:800;color:var(--color-primary);">R$ 15,20</div>
            <div style="font-size:1rem;color:var(--color-text-light);">ou R$ 147 à vista</div>
          </div>
          <a href="#" class="btn-shiny" style="width:100%;" data-form="vip">
            <span class="btn-text">COMPRAR INGRESSO VIP</span>
            <div class="btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></div>
          </a>
          <div style="margin-top:1.5rem;"><ProgressBar variant="minimal" /></div>
        </div>
      </div>
    </div>
  </section>

  <footer style="background:#1A1A1A;color:rgba(255,255,255,0.6);padding:var(--space-xl) var(--space-sm) var(--space-lg);text-align:center;">
    <div class="container">
      <h3 style="color:white;margin-bottom:1rem;">Suporte no WhatsApp</h3>
      <a href="https://wa.me/554799557669" class="btn" style="background:#25D366;box-shadow:0 4px 14px rgba(37,211,102,0.4);">FALAR COM ATENDENTE</a>
      <div style="margin-top:4rem;border-top:1px solid rgba(255,255,255,0.1);padding-top:2rem;font-size:0.75rem;">
        <p>Ney Felipe Fernandes | © Copyright 2025 | CNPJ: 38.560.882/0001-12</p>
      </div>
    </div>
  </footer>

  <FormModal />
</Layout>

<style>
  .hero-v3 {
    background-image: url('/images/background-pagina-verde-hero.png');
    background-size: cover;
    background-position: top right;
    background-repeat: no-repeat;
    padding: 80px 0 60px;
    min-height: 680px;
    display: flex;
    align-items: center;
  }
  .hero-v3-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
  }
  .hero-v3-text { display:flex; flex-direction:column; align-items:flex-start; }
  .hero-v3-visual { position: relative; }
  .badge-row { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:28px; }
  .badge-green { background:#f0fdf4;color:#16A34A;border:1px solid #dcfce7;padding:6px 14px;border-radius:8px;font-size:13px;font-weight:700; }
  .badge-blue { background:#e0f2fe;color:#2563EB;border:1px solid #bfdbfe;padding:6px 14px;border-radius:8px;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:6px; }
  .live-dot { color:#DC2626;animation:pulse-live 2s ease-in-out infinite; }
  @keyframes pulse-live { 0%,100%{opacity:1}50%{opacity:0.4} }
  .zoom { color:#2D8CFF;font-size:15px; }
  .h1-v3 { font-size:clamp(26px,4vw,50px);line-height:1.1;font-weight:800;color:#111827;margin-bottom:20px;letter-spacing:-0.04em; }
  .serif-green { font-family:'Playfair Display',serif;font-style:italic;font-weight:400;color:#16A34A; }
  .linha-sub { font-size:0.75em;color:#4B5563;font-weight:600; }
  .sub-v3 { font-size:18px;color:#4B5563;line-height:1.65;margin-bottom:20px;max-width:580px; }
  .urgency-v3 { background:#FEF3C7;border:1px solid #FCD34D;color:#92400E;border-radius:8px;padding:10px 16px;font-size:14px;margin-bottom:24px;width:100%;max-width:580px; }
  .cta-v3 { display:flex;flex-direction:column;align-items:flex-start;gap:10px;margin-bottom:20px;width:100%;max-width:520px; }
  .btn-main-v3 { display:inline-flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,#16A34A,#15803d);color:white;font-weight:800;font-size:14px;padding:18px 24px;border-radius:12px;text-decoration:none;width:100%;box-shadow:0 8px 24px rgba(22,163,74,0.35);transition:transform 0.2s,box-shadow 0.2s;letter-spacing:0.02em; }
  .btn-main-v3:hover { transform:translateY(-2px);box-shadow:0 12px 32px rgba(22,163,74,0.45); }
  .anchor { font-size:13px;color:#6B7280;font-style:italic; }
  .progress-wrap { width:100%;max-width:520px; }
  .spoiler-v3 { margin:32px auto;max-width:900px;background:rgba(22,163,74,0.04);border-radius:16px;padding:20px 24px;display:flex;gap:16px;align-items:center;border:1px solid rgba(22,163,74,0.08);font-size:14px;line-height:1.6;color:#4B5563; }
  @media (max-width:1024px) {
    .hero-v3 { background-image:none;min-height:auto;padding:40px 0 20px; }
    .hero-v3-grid { grid-template-columns:1fr; }
    .hero-v3-visual { display:none; }
    .hero-v3-text { align-items:center;text-align:center; }
    .cta-v3 { align-items:center; }
    .spoiler-v3 { flex-direction:column;text-align:center; }
  }
</style>
