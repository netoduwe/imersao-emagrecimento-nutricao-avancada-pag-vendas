---
// Quiz standalone — sem header/nav
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teste: Qual nutricionista você é? | Imersão Emagrecimento</title>
  <link rel="icon" href="/favicon.ico" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital@1&display=swap" rel="stylesheet"/>
</head>
<body>

<div id="app">

  <!-- INTRO -->
  <div class="screen active" id="s-intro">
    <div class="card intro-card">
      <div class="chip">🧪 DIAGNÓSTICO CLÍNICO</div>
      <h1>Você está atualizado para o paciente de emagrecimento de 2025?</h1>
      <p>4 perguntas revelam seu nível clínico — e o que fazer agora.</p>
      <button id="btn-start" onclick="start()">
        <span>INICIAR DIAGNÓSTICO</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <small>⏱ Menos de 60 segundos</small>
    </div>
  </div>

  <!-- QUIZ -->
  <div class="screen" id="s-quiz">
    <div class="card quiz-card">
      <div class="steps" id="steps"></div>
      <div class="q-num" id="q-num">1 / 4</div>
      <div class="q-text" id="q-text"></div>
      <div class="opts" id="opts"></div>
    </div>
  </div>

  <!-- RESULTADO -->
  <div class="screen" id="s-result">
    <!-- DIAGNÓSTICO -->
    <div class="card result-header" id="r-header">
      <div class="r-badge" id="r-badge"></div>
      <h2 id="r-title"></h2>
      <p id="r-desc"></p>
    </div>

    <!-- AUTORIDADE NEY -->
    <div class="card authority-card">
      <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" class="ney-img"/>
      <div class="authority-text">
        <div class="chip chip-green">👨‍🔬 QUEM VAI TE ENSINAR</div>
        <h3>Ney Felipe — 18 anos no campo de batalha clínico</h3>
        <p>Nutricionista pioneiro da Nutrição Funcional no Brasil. Mestre em Biologia Molecular, Doutorando em Saúde Pública e fundador da Nutrição Avançada. Já formou mais de <strong>3.000 nutricionistas</strong> na prática clínica real.</p>
        <div class="creds">
          <span>✅ 18 anos de clínica</span>
          <span>✅ Mestre em Biologia Molecular</span>
          <span>✅ 3.000+ alunos formados</span>
          <span>✅ 2 livros publicados</span>
        </div>
      </div>
    </div>

    <!-- BENEFÍCIOS -->
    <div class="card benefits-card">
      <div class="chip">📚 O QUE VOCÊ VAI APRENDER</div>
      <h3>Em 1 dia ao vivo você vai dominar:</h3>
      <div class="benefits-grid">
        <div class="benefit-item"><span>🧬</span><span>Canetas emagrecedoras (GLP-1) — manejo clínico completo</span></div>
        <div class="benefit-item"><span>🔬</span><span>Emagrecimento além do déficit calórico</span></div>
        <div class="benefit-item"><span>🧠</span><span>Aspectos neuroendócrinos da obesidade</span></div>
        <div class="benefit-item"><span>🦠</span><span>Epigenética, inflamação e tecido adiposo</span></div>
        <div class="benefit-item"><span>🛠️</span><span>Estratégias de adesão comportamental</span></div>
        <div class="benefit-item"><span>📊</span><span>Caso clínico real: do diagnóstico à prescrição</span></div>
      </div>
      <div class="event-meta">
        <span>📅 16 de Maio</span>
        <span>⏰ 9h às 18h</span>
        <span>💻 Online via Zoom</span>
        <span>⚡ Ao vivo</span>
      </div>
    </div>

    <!-- OFERTA -->
    <div class="card offer-card">
      <div class="urgency-bar">⚠️ <strong>Últimos ingressos</strong> — Evento em 16 de Maio</div>
      <h3 class="offer-title">Escolha seu ingresso</h3>

      <div class="ticket normal-ticket">
        <div class="ticket-info">
          <div class="ticket-name">Ingresso Normal</div>
          <div class="ticket-perks">Ao vivo · 8h · Grupo · Materiais + Mini Curso</div>
        </div>
        <div class="ticket-price-col">
          <del>R$97</del>
          <div class="ticket-price">R$19,90</div>
        </div>
      </div>
      <a href="https://pay.hotmart.com/Y105539078H?off=rzzgx17r&checkoutMode=10" class="btn-buy btn-normal" target="_blank">
        COMPRAR NORMAL — R$19,90 →
      </a>

      <div class="ticket vip-ticket">
        <div class="vip-badge-pill">⭐ MAIS COMPLETO</div>
        <div class="ticket-info">
          <div class="ticket-name">Ingresso VIP</div>
          <div class="ticket-perks">Tudo do normal + Gravação 1 ano · Certificado · 3 E-books · Ressaca do Evento · Cashback</div>
        </div>
        <div class="ticket-price-col">
          <del>R$297</del>
          <div class="ticket-price vip-price">R$147</div>
          <small>ou 12x R$15,20</small>
        </div>
      </div>
      <a href="https://pay.hotmart.com/W93818806I?off=l3p9qwc8&checkoutMode=10" class="btn-buy btn-vip" target="_blank">
        COMPRAR VIP — R$147 →
      </a>

      <div class="trust">🔒 Compra 100% segura &nbsp;·&nbsp; PIX · Cartão · Boleto</div>
    </div>
  </div>

</div>

<script is:inline>
const Q = [
  {
    q: "Quando um paciente chega com Mounjaro ou Ozempic receitado, como você se sente?",
    opts: [
      { t: "😎  Preparado — sei ajustar a dieta", s: 3 },
      { t: "🤔  Tenho base, mas ainda tenho dúvidas", s: 2 },
      { t: "😬  Não sei muito bem o que fazer", s: 1 },
      { t: "🙅  Meus pacientes ainda não usam isso", s: 1 }
    ]
  },
  {
    q: "Você explica clinicamente por que o emagrecimento travou mesmo com déficit calórico sendo seguido?",
    opts: [
      { t: "✅  Sim, com segurança e embasamento", s: 3 },
      { t: "📖  Às vezes, mas me falta profundidade", s: 2 },
      { t: "❌  Não tenho essa resposta ainda", s: 1 }
    ]
  },
  {
    q: "Qual é seu maior desafio com pacientes de emagrecimento?",
    opts: [
      { t: "🤝  Fazer o paciente aderir ao plano", s: 2 },
      { t: "🔬  Segurança clínica em casos complexos", s: 1 },
      { t: "📡  Me manter atualizado com a ciência", s: 1 },
      { t: "💰  Me diferenciar e cobrar mais", s: 2 }
    ]
  },
  {
    q: "Há quanto tempo você é nutricionista?",
    opts: [
      { t: "🎓  Ainda sou estudante", s: 1 },
      { t: "🌱  Menos de 3 anos", s: 2 },
      { t: "⚡  Entre 3 e 10 anos", s: 2 },
      { t: "🏆  Mais de 10 anos", s: 3 }
    ]
  }
];

const R = [
  { min:4, max:6, badge:"🌱 NUTRICIONISTA EM CONSTRUÇÃO", title:"Você está no momento exato para dar o próximo salto.", desc:"Você pode aprender já com o raciocínio clínico certo, sem precisar desaprender anos de prática ultrapassada. A Imersão vai te dar a base que a faculdade não deu — com quem atende há 18 anos." },
  { min:7, max:9, badge:"⚡ NUTRICIONISTA EM TRANSIÇÃO", title:"Você tem fundamentos. Faltam as peças para fechar o quebra-cabeça.", desc:"Você já atende, tem experiência — mas sente que algo falta quando o caso fica complexo. A Imersão vai preencher essas lacunas com a ciência mais atual e prática clínica real." },
  { min:10, max:12, badge:"🚀 NUTRICIONISTA AVANÇADO", title:"Você já tem base sólida. A Imersão vai te colocar na vanguarda.", desc:"Profissionais no seu nível se separam dos demais pela atualização constante. GLP-1, obesidade sistêmica, epigenética — a Imersão traz o que há de mais atual para quem já chegou longe." }
];

let cur = 0, score = 0;

// Web Audio
function snd(type) {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const g = ctx.createGain();
    g.connect(ctx.destination);
    if (type === 'click') {
      const o = ctx.createOscillator();
      o.connect(g); o.type = 'sine'; o.frequency.value = 880;
      g.gain.setValueAtTime(0.15, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
      o.start(); o.stop(ctx.currentTime + 0.12);
    } else if (type === 'win') {
      [523, 659, 784, 1047].forEach((f, i) => {
        const o = ctx.createOscillator();
        o.connect(g); o.type = 'sine'; o.frequency.value = f;
        const t = ctx.currentTime + i * 0.12;
        g.gain.setValueAtTime(0.18, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
        o.start(t); o.stop(t + 0.2);
      });
    }
  } catch(e) {}
}

function show(id) {
  document.querySelectorAll('.screen').forEach(s => { s.classList.remove('active'); s.classList.add('exiting'); });
  setTimeout(() => {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('exiting'));
    document.getElementById(id).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }, 280);
}

function start() { snd('click'); show('s-quiz'); renderQ(); }

function renderQ() {
  const q = Q[cur];
  // steps
  const steps = document.getElementById('steps');
  steps.innerHTML = Q.map((_,i) => `<div class="step ${i < cur ? 'done' : i === cur ? 'active' : ''}"></div>`).join('');
  document.getElementById('q-num').textContent = `${cur + 1} / ${Q.length}`;
  const qEl = document.getElementById('q-text');
  qEl.style.opacity = '0'; qEl.textContent = q.q;
  setTimeout(() => { qEl.style.opacity = '1'; }, 50);
  const opts = document.getElementById('opts');
  opts.innerHTML = '';
  q.opts.forEach((o, i) => {
    const btn = document.createElement('button');
    btn.className = 'opt';
    btn.innerHTML = `<span class="opt-emoji">${o.t.split(' ')[0]}</span><span class="opt-label">${o.t.split(' ').slice(1).join(' ')}</span>`;
    btn.style.animationDelay = (i * 70) + 'ms';
    btn.onclick = () => pick(o.s, btn);
    opts.appendChild(btn);
  });
}

function pick(s, btn) {
  snd('click');
  document.querySelectorAll('.opt').forEach(b => { b.disabled = true; b.classList.add('disabled'); });
  btn.classList.add('chosen');
  score += s;
  setTimeout(() => {
    cur++;
    if (cur < Q.length) renderQ();
    else { snd('win'); setTimeout(() => showResult(), 400); }
  }, 500);
}

function showResult() {
  const r = R.find(r => score >= r.min && score <= r.max) || R[1];
  document.getElementById('r-badge').textContent = r.badge;
  document.getElementById('r-title').textContent = r.title;
  document.getElementById('r-desc').textContent = r.desc;
  show('s-result');
}
</script>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: linear-gradient(160deg, #f0fdf4 0%, #F7F8F6 50%, #e0f2fe 100%);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
#app { padding: 24px 16px 60px; max-width: 640px; margin: 0 auto; }

/* SCREENS */
.screen { display: none; }
.screen.active { display: block; animation: fadeUp .35s cubic-bezier(.22,.68,0,1.2); }
.screen.exiting { animation: fadeDown .28s ease forwards; }
@keyframes fadeUp { from { opacity:0; transform:translateY(24px) scale(.98); } to { opacity:1; transform:none; } }
@keyframes fadeDown { to { opacity:0; transform:translateY(-16px); } }

/* CARDS */
.card {
  background: rgba(255,255,255,.92);
  backdrop-filter: blur(12px);
  border-radius: 24px;
  padding: 36px 32px;
  box-shadow: 0 4px 24px rgba(0,0,0,.07), 0 1px 3px rgba(0,0,0,.05);
  border: 1px solid rgba(255,255,255,.8);
  margin-bottom: 16px;
}

/* CHIP */
.chip {
  display: inline-block;
  background: #f0fdf4; color: #16A34A;
  border: 1px solid #dcfce7;
  padding: 5px 14px; border-radius: 99px;
  font-size: 11px; font-weight: 800;
  letter-spacing: .06em; margin-bottom: 20px;
}
.chip-green { background: #f0fdf4; color: #16A34A; border-color: #dcfce7; }

/* INTRO */
.intro-card h1 {
  font-size: clamp(22px, 5vw, 30px);
  font-weight: 900; color: #111827;
  line-height: 1.2; letter-spacing: -.03em;
  margin-bottom: 14px;
}
.intro-card p { font-size: 17px; color: #4B5563; line-height: 1.6; margin-bottom: 32px; }
#btn-start {
  width: 100%;
  background: linear-gradient(135deg, #16A34A, #15803d);
  color: white; border: none; cursor: pointer;
  font-size: 16px; font-weight: 800;
  padding: 20px 28px; border-radius: 16px;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  box-shadow: 0 8px 32px rgba(22,163,74,.35), 0 2px 8px rgba(22,163,74,.2);
  transition: transform .18s cubic-bezier(.34,1.56,.64,1), box-shadow .18s;
  letter-spacing: .03em; margin-bottom: 14px;
}
#btn-start:hover { transform: scale(1.02) translateY(-2px); box-shadow: 0 14px 40px rgba(22,163,74,.4); }
#btn-start:active { transform: scale(.98); }
.intro-card small { display: block; text-align: center; font-size: 13px; color: #9CA3AF; }

/* STEPS */
.steps { display: flex; gap: 8px; margin-bottom: 20px; }
.step { flex: 1; height: 5px; border-radius: 99px; background: #E5E7EB; transition: background .3s, transform .3s; }
.step.done { background: #16A34A; }
.step.active { background: #16A34A; opacity: .5; transform: scaleX(.8); }

.q-num { font-size: 12px; font-weight: 700; color: #16A34A; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 18px; }

.q-text { font-size: clamp(17px, 3.5vw, 21px); font-weight: 700; color: #111827; line-height: 1.4; margin-bottom: 28px; transition: opacity .25s; }

/* OPTIONS — Apple-level */
.opts { display: flex; flex-direction: column; gap: 12px; }
.opt {
  background: #FAFAFA;
  border: 2px solid #E5E7EB;
  border-radius: 16px;
  padding: 18px 20px;
  display: flex; align-items: center; gap: 14px;
  cursor: pointer; text-align: left;
  transition: all .2s cubic-bezier(.34,1.56,.64,1);
  animation: optIn .3s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes optIn { from { opacity:0; transform:translateX(-12px) scale(.96); } to { opacity:1; transform:none; } }
.opt-emoji { font-size: 22px; flex-shrink: 0; }
.opt-label { font-size: 15px; font-weight: 600; color: #1F2937; line-height: 1.3; }
.opt:hover:not(:disabled) {
  border-color: #16A34A; background: #f0fdf4;
  transform: scale(1.02) translateX(4px);
  box-shadow: 0 4px 20px rgba(22,163,74,.15);
}
.opt:active:not(:disabled) { transform: scale(.97); }
.opt.chosen {
  border-color: #16A34A; background: #16A34A;
  transform: scale(1.02);
  box-shadow: 0 6px 24px rgba(22,163,74,.35);
}
.opt.chosen .opt-label { color: white; }
.opt.chosen .opt-emoji { filter: brightness(0) invert(1); }
.opt.disabled:not(.chosen) { opacity: .45; }

/* RESULT */
.result-header { text-align: center; }
.r-badge { display: inline-block; background: #f0fdf4; color: #16A34A; border: 1.5px solid #dcfce7; padding: 8px 18px; border-radius: 99px; font-size: 13px; font-weight: 800; margin-bottom: 20px; }
.result-header h2 { font-size: clamp(19px, 4vw, 24px); font-weight: 800; color: #111827; line-height: 1.3; margin-bottom: 14px; letter-spacing: -.02em; }
.result-header p { font-size: 16px; color: #4B5563; line-height: 1.7; }

/* AUTHORITY */
.authority-card { display: flex; gap: 24px; align-items: flex-start; }
.ney-img { width: 90px; height: 110px; object-fit: cover; border-radius: 16px; flex-shrink: 0; background: #f0fdf4; }
.authority-text h3 { font-size: 17px; font-weight: 800; color: #111827; margin-bottom: 10px; line-height: 1.3; }
.authority-text p { font-size: 14px; color: #4B5563; line-height: 1.65; margin-bottom: 14px; }
.creds { display: flex; flex-wrap: wrap; gap: 8px; }
.creds span { font-size: 12px; font-weight: 600; color: #16A34A; background: #f0fdf4; padding: 4px 10px; border-radius: 99px; border: 1px solid #dcfce7; }

/* BENEFITS */
.benefits-card h3 { font-size: 18px; font-weight: 800; color: #111827; margin-bottom: 20px; }
.benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
.benefit-item { display: flex; gap: 10px; align-items: flex-start; background: #F9FAFB; border-radius: 12px; padding: 12px; border: 1px solid #F3F4F6; }
.benefit-item span:first-child { font-size: 18px; flex-shrink: 0; }
.benefit-item span:last-child { font-size: 13px; font-weight: 600; color: #374151; line-height: 1.4; }
.event-meta { display: flex; flex-wrap: wrap; gap: 10px; }
.event-meta span { font-size: 13px; font-weight: 700; color: #16A34A; background: #f0fdf4; padding: 6px 12px; border-radius: 99px; border: 1px solid #dcfce7; }

/* OFFER */
.urgency-bar { background: #FEF3C7; border: 1px solid #FCD34D; color: #92400E; border-radius: 10px; padding: 12px 16px; font-size: 14px; margin-bottom: 24px; }
.offer-title { font-size: 20px; font-weight: 800; color: #111827; margin-bottom: 16px; }

.ticket { background: #F9FAFB; border: 1.5px solid #E5E7EB; border-radius: 16px; padding: 20px; margin-bottom: 12px; position: relative; }
.vip-ticket { background: #f0fdf4; border-color: #16A34A; margin-top: 20px; }
.vip-badge-pill { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #16A34A; color: white; font-size: 11px; font-weight: 800; padding: 4px 14px; border-radius: 99px; white-space: nowrap; }

.ticket-info .ticket-name { font-size: 16px; font-weight: 800; color: #111827; margin-bottom: 4px; }
.ticket-info .ticket-perks { font-size: 12px; color: #6B7280; line-height: 1.5; }
.ticket-price-col { margin-top: 12px; }
.ticket-price-col del { font-size: 12px; color: #9CA3AF; }
.ticket-price { font-size: 28px; font-weight: 900; color: #111827; line-height: 1; }
.vip-price { color: #16A34A; }
.ticket-price-col small { font-size: 12px; color: #6B7280; }

.btn-buy {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 18px; border-radius: 14px;
  font-size: 15px; font-weight: 800; letter-spacing: .03em;
  text-decoration: none; margin-bottom: 8px;
  transition: transform .18s cubic-bezier(.34,1.56,.64,1), box-shadow .18s;
}
.btn-normal { background: #1F2937; color: white; box-shadow: 0 4px 16px rgba(0,0,0,.2); }
.btn-normal:hover { transform: scale(1.02) translateY(-1px); box-shadow: 0 8px 24px rgba(0,0,0,.25); }
.btn-vip { background: linear-gradient(135deg,#16A34A,#15803d); color: white; box-shadow: 0 6px 24px rgba(22,163,74,.35); }
.btn-vip:hover { transform: scale(1.02) translateY(-2px); box-shadow: 0 12px 32px rgba(22,163,74,.45); }
.btn-buy:active { transform: scale(.97); }

.trust { text-align: center; font-size: 12px; color: #9CA3AF; margin-top: 16px; }

@media (max-width: 480px) {
  .card { padding: 24px 20px; }
  .authority-card { flex-direction: column; }
  .ney-img { width: 72px; height: 90px; }
  .benefits-grid { grid-template-columns: 1fr; }
}
</style>
</body>
</html>
