---
import Layout from '../layouts/Layout.astro';
import FormModal from '../components/FormModalV7.astro';
import T9Tracking from '../components/T9Tracking.astro';
import '../styles/imersao-v8.css';

const EVENT_DATE = '01 de Agosto de 2026';
const EVENT_TIME = '9h às 18h';
---

<Layout
  title="Oferta Secreta • Imersão em Emagrecimento e GLP-1"
  theme="green"
  hideHeader={true}
  hideUrgency={true}
  hideChatbase={true}
>
  <T9Tracking />
  <FormModal />

  <main class="v8-viewport-wrapper">
    <!-- Barra Superior de Urgência Versão V8 -->
    <div class="v8-urgency-bar">
      <div class="v8-urgency-left">
        <span class="v8-badge-red">
          <span class="v8-pulse-dot"></span>
          VISUALIZAÇÃO ÚNICA
        </span>
        <span class="v8-urgency-text">Esta página expira em <strong id="alert-timer-text">15:00</strong> e não reaparecerá.</span>
      </div>
    </div>

    <!-- Container Principal (Dobra Única Estilo V8) -->
    <div class="v8-hero-container">
      <div class="v8-glass-card">
        
        <!-- Tag Superior -->
        <div class="v8-pill-tag">
          <span>OFERTA EXCLUSIVA DE RETARGETING • 5ª EDIÇÃO</span>
        </div>

        <!-- Título Estilo V8 (Playfair Display + Inter) -->
        <h1 class="v8-title">
          Garanta sua vaga na Imersão Nutrição Avançada no <span class="v8-serif-highlight">Emagrecimento</span>
        </h1>

        <!-- Subtítulo -->
        <p class="v8-subtitle">
          Conduta clínica prática para nutricionistas no manejo de pacientes em uso de <strong>GLP-1</strong> e condutas em <strong>emagrecimento definitivo</strong>.
        </p>

        <!-- Box de Cronômetro V8 -->
        <div class="v8-timer-card">
          <span class="v8-timer-label">ESTA OPORTUNIDADE EXPIRA E SERÁ REDIRECIONADA EM:</span>
          <div class="v8-timer-display">
            <div class="v8-time-box">
              <span id="timer-minutes" class="v8-time-number">15</span>
              <span class="v8-time-unit">MINUTOS</span>
            </div>
            <span class="v8-time-colon">:</span>
            <div class="v8-time-box">
              <span id="timer-seconds" class="v8-time-number">00</span>
              <span class="v8-time-unit">SEGUNDOS</span>
            </div>
          </div>
        </div>

        <!-- Preço V8 -->
        <div class="v8-price-card">
          <span class="v8-price-old">De R$ 297,00 por apenas</span>
          <div class="v8-price-main">
            <span class="v8-currency">R$</span>
            <span class="v8-amount">19</span>
            <span class="v8-cents">,90</span>
          </div>
          <span class="v8-price-sub">ou 2x de R$ 10,40 no cartão</span>
        </div>

        <!-- Botão CTA Estilo V8 (Verde Esmeralda Arredondado) -->
        <div class="v8-cta-wrapper">
          <button 
            type="button"
            class="v8-btn-primary"
            data-form="normal"
          >
            <span>GARANTIR MEU INGRESSO POR R$ 19,90</span>
          </button>
          <span class="v8-cta-guarantee">✓ Acesso ao vivo no Zoom + 1 ano de gravação liberada</span>
        </div>

        <!-- Rodapé de Confiança V8 -->
        <div class="v8-trust-bar">
          <div class="v8-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Pagamento Seguro</span>
          </div>
          <div class="v8-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span>Garantia de 7 Dias</span>
          </div>
          <div class="v8-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span>Certificado Incluso</span>
          </div>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  (function initTimer() {
    const TIMER_DURATION_MS = 15 * 60 * 1000;
    const STORAGE_KEY = 'fna_v8_unica_vez_timer_expires';
    const REDIRECT_URL = 'https://ingressos.institutonutricaoavancada.com/imersao-5ed-v8/';

    let expiresAt = localStorage.getItem(STORAGE_KEY);
    const now = Date.now();

    if (!expiresAt || isNaN(expiresAt)) {
      expiresAt = now + TIMER_DURATION_MS;
      localStorage.setItem(STORAGE_KEY, expiresAt.toString());
    } else {
      expiresAt = parseInt(expiresAt, 10);
    }

    const minutesEl = document.getElementById('timer-minutes');
    const secondsEl = document.getElementById('timer-seconds');
    const alertTextEl = document.getElementById('alert-timer-text');

    function update() {
      const current = Date.now();
      const diff = expiresAt - current;

      if (diff <= 0) {
        if (minutesEl) minutesEl.textContent = '00';
        if (secondsEl) secondsEl.textContent = '00';
        if (alertTextEl) alertTextEl.textContent = '00:00';
        
        window.location.href = REDIRECT_URL;
        return;
      }

      const totalSeconds = Math.floor(diff / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;

      const mStr = minutes.toString().padStart(2, '0');
      const sStr = seconds.toString().padStart(2, '0');

      if (minutesEl) minutesEl.textContent = mStr;
      if (secondsEl) secondsEl.textContent = sStr;
      if (alertTextEl) alertTextEl.textContent = `${mStr}:${sStr}`;
    }

    update();
    setInterval(update, 1000);
  })();
</script>

<style>
  :root {
    --v8-bg: #F5F4ED;
    --v8-card-bg: #FFFFFF;
    --v8-text: #071209;
    --v8-text-light: #5C675E;
    --v8-primary: #15966A;
    --v8-primary-hover: #0E7D57;
    --v8-serif-green: #087C36;
    --v8-red-bg: #FEF2F2;
    --v8-red: #DC2626;
    --v8-border: rgba(0, 0, 0, 0.08);
  }

  /* Reset & Layout V8 */
  .v8-viewport-wrapper {
    min-height: 100vh;
    width: 100%;
    background-color: var(--v8-bg);
    color: var(--v8-text);
    font-family: 'Inter', -apple-system, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  /* Barra de Urgência Estilo V8 */
  .v8-urgency-bar {
    width: 100%;
    max-width: 580px;
    background: #FFFFFF;
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 999px;
    padding: 8px 16px;
    margin-bottom: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .v8-urgency-left {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .v8-badge-red {
    background: var(--v8-red-bg);
    color: var(--v8-red);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .v8-pulse-dot {
    width: 6px;
    height: 6px;
    background-color: var(--v8-red);
    border-radius: 50%;
    animation: v8Pulse 1.5s infinite;
  }
  @keyframes v8Pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }
  .v8-urgency-text {
    font-size: 12px;
    color: var(--v8-text-light);
    font-weight: 500;
  }
  .v8-urgency-text strong {
    color: var(--v8-red);
    font-weight: 800;
  }

  /* Container Principal */
  .v8-hero-container {
    width: 100%;
    max-width: 580px;
    display: flex;
    justify-content: center;
  }

  /* Cartão Editorial V8 */
  .v8-glass-card {
    width: 100%;
    background: var(--v8-card-bg);
    border: 1px solid var(--v8-border);
    border-radius: 24px;
    padding: 32px 28px;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Tag Pill */
  .v8-pill-tag {
    background: rgba(21, 150, 106, 0.08);
    color: var(--v8-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  /* Título V8 (Playfair Display) */
  .v8-title {
    font-size: 28px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--v8-text);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  .v8-serif-highlight {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 600;
    color: var(--v8-serif-green);
  }

  /* Subtítulo V8 */
  .v8-subtitle {
    font-size: 15px;
    line-height: 1.5;
    color: var(--v8-text-light);
    margin-bottom: 22px;
    max-width: 500px;
  }
  .v8-subtitle strong {
    color: var(--v8-text);
  }

  /* Timer Box V8 */
  .v8-timer-card {
    width: 100%;
    background: #FAF9F5;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 16px;
    padding: 12px 16px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .v8-timer-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--v8-text-light);
  }
  .v8-timer-display {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .v8-time-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid rgba(21, 150, 106, 0.2);
    border-radius: 10px;
    padding: 4px 14px;
    min-width: 64px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }
  .v8-time-number {
    font-size: 24px;
    font-weight: 800;
    color: var(--v8-primary);
    font-family: monospace;
  }
  .v8-time-unit {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--v8-text-light);
  }
  .v8-time-colon {
    font-size: 22px;
    font-weight: 800;
    color: var(--v8-primary);
  }

  /* Preço V8 */
  .v8-price-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
  }
  .v8-price-old {
    font-size: 13px;
    text-decoration: line-through;
    color: #94A3B8;
    margin-bottom: 2px;
  }
  .v8-price-main {
    display: flex;
    align-items: baseline;
    color: var(--v8-text);
    line-height: 1;
  }
  .v8-currency {
    font-size: 20px;
    font-weight: 700;
    margin-right: 2px;
    color: var(--v8-primary);
  }
  .v8-amount {
    font-size: 46px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--v8-text);
  }
  .v8-cents {
    font-size: 24px;
    font-weight: 800;
    color: var(--v8-text);
  }
  .v8-price-sub {
    font-size: 12px;
    color: var(--v8-text-light);
    margin-top: 4px;
  }

  /* Botão CTA V8 */
  .v8-cta-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
  }
  .v8-btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 24px;
    background-color: var(--v8-primary);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(21, 150, 106, 0.3);
    transition: all 0.25s ease;
  }
  .v8-btn-primary:hover {
    background-color: var(--v8-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(21, 150, 106, 0.45);
  }
  .v8-cta-guarantee {
    font-size: 11px;
    color: var(--v8-text-light);
    margin-top: 8px;
    font-weight: 500;
  }

  /* Trust Bar V8 */
  .v8-trust-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .v8-trust-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--v8-text-light);
    font-weight: 500;
  }
  .v8-trust-item svg {
    width: 14px;
    height: 14px;
    color: var(--v8-primary);
  }

  /* Responsivo */
  @media (max-width: 480px) {
    .v8-glass-card {
      padding: 24px 18px;
      border-radius: 20px;
    }
    .v8-title {
      font-size: 22px;
    }
    .v8-subtitle {
      font-size: 13px;
    }
    .v8-amount {
      font-size: 38px;
    }
    .v8-btn-primary {
      font-size: 13px;
      padding: 14px 18px;
    }
    .v8-urgency-text {
      font-size: 11px;
    }
  }
</style>
