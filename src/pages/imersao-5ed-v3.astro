---
import Layout from '../layouts/Layout.astro';
import FormModal from '../components/FormModal.astro';
import ProgressBar from '../components/ProgressBar.astro';

// Dados do evento
const EVENT_DATE = '01 de Agosto de 2026';
const EVENT_TIME = '9h às 18h';
const EVENT_FORMAT = 'Online via Zoom';
const LOTE = 'Lote zero';
const PRICE_BASICO = 'R$ 19,90';
const PRICE_VIP = 'R$ 147,00';
---

<Layout title={`Imersão em Emagrecimento — 5ª Edição | ${EVENT_DATE} | Nutrição Avançada`} theme="green">

  <!-- ══════════════════════════════════════
       HERO V3 — DARK & RED THEME (REFERENCE STYLE)
       ══════════════════════════════════════ -->
  <section class="hero-v3-section" id="imersao">
    <div class="container hero-v3-grid">
      <!-- LEFT COLUMN -->
      <div class="hero-v3-content">
        
        <!-- Header Info Group -->
        <div class="hero-v3-header-group">
          <!-- Event Label -->
          <div class="hero-v3-event-label">
            ★ Imersão em Emagrecimento | 5ª Edição
          </div>
          
          <!-- Date Pill (Sticky top style) -->
          <div class="hero-v3-date-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="calendar-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>{EVENT_DATE} | {EVENT_TIME}</span>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="hero-v3-headline">
          Trate a obesidade e o emagrecimento com base em dados e fisiologia clínica consolidada.
        </h1>

        <!-- Subheadline (User requested exact text) -->
        <p class="hero-v3-sub">
          Um dia inteiro destravando o raciocínio clínico que você precisa para atender com segurança e entregar resultados duradouros para seus pacientes.
        </p>

        <!-- CTA Button V3 (Red theme highlight) -->
        <div class="hero-v3-cta-wrap">
          <a href="#preco" class="btn-v3-hero">
            Pegar meu ingresso | {LOTE} <span class="btn-v3-icon">🎟</span>
          </a>
          
          <div class="hero-v3-progress-wrap">
            <div class="hero-v3-progress-bar">
              <div class="hero-v3-progress-fill" style="width: 78%;">
                <span class="progress-glow-dot"></span>
              </div>
            </div>
            <div class="hero-v3-progress-labels">
              <span>78% dos ingressos vendidos</span>
              <span>de R$ 97,00 por <strong class="highlight-red">{PRICE_BASICO}</strong></span>
            </div>
          </div>
        </div>

        <!-- Social Proof Stats (Reference style) -->
        <div class="hero-v3-social-proof-grid">
          <div class="proof-stat-item">
            <span class="stat-arrow">↗</span>
            <div class="stat-details">
              <strong>70.1%</strong>
              <span>Superou muito as expectativas</span>
            </div>
          </div>
          <div class="proof-stat-item">
            <span class="stat-arrow">↗</span>
            <div class="stat-details">
              <strong>99.4%</strong>
              <span>Avaliação altamente positiva</span>
            </div>
          </div>
          <div class="proof-stat-item">
            <span class="stat-arrow">↗</span>
            <div class="stat-details">
              <strong>174</strong>
              <span>Alunos reais avaliados</span>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN (Speaker image layered on dark bg) -->
      <div class="hero-v3-right">
        <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" class="hero-v3-speaker-img" />
        <div class="hero-v3-logos-support">
          <span>Apoio:</span>
          <strong class="support-brand">NUTRIÇÃO AVANÇADA</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       SEÇÃO DE CLIENTES NOTÁVEIS (GRID DE TESTEMUNHOS GRANDES E LEGÍVEIS)
       ══════════════════════════════════════ -->
  <section class="section-notaveis">
    <div class="container">
      <h2 class="section-title text-center">Quem já validou nosso método e esteve com a gente</h2>
      <p class="section-sub text-center" style="max-width: 600px; margin: 0 auto 40px;">
        Profissionais que utilizam as estratégias práticas da Nutrição Avançada em seus consultórios.
      </p>

      <!-- Real Screenshots with Lightbox modal zoom -->
      <div class="real-screenshots-block">
        <div class="screenshots-grid">
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_1.png">
            <img src="/images/depoimentos/Screenshot_1.png" alt="Depoimento 1" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>

          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_3.png">
            <img src="/images/depoimentos/Screenshot_3.png" alt="Depoimento 3" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_14.png">
            <img src="/images/depoimentos/Screenshot_14.png" alt="Depoimento 4" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_23.png">
            <img src="/images/depoimentos/Screenshot_23.png" alt="Depoimento 5" class="screenshot-img" loading="lazy" />
            <div class="screenshot-hover-overlay">
              <span>🔍 Ampliar Depoimento</span>
            </div>
          </div>
        </div>
      </div>

      <div class="notaveis-footer-text text-center">
        <p>Mensagens e depoimentos reais de quem participou da última edição da Imersão.</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       A GRANDE PERGUNTA (TRANSIÇÃO E CONTEXTO DE MERCADO LAPIDADO)
       ══════════════════════════════════════ -->
  <section class="section-pergunta">
    <div class="container text-center">
      <h2 class="pergunta-headline">
        Com o uso desenfreado de análogos de GLP-1 (como Ozempic e Mounjaro), o mercado agora exige nutricionistas preparados para tratar os efeitos colaterais e sustentar o emagrecimento a longo prazo. Afinal, a medicação passa, mas a nutrição é a única que mantém o resultado.
      </h2>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       LINHA DO TEMPO DINÂMICA (CRONOGRAMA REAL DO EVENTO)
       ══════════════════════════════════════ -->
  <section class="section-timeline" id="cronograma-evento">
    <div class="container timeline-grid">
      <!-- Left side: vertical line and Ney photo (STICKY TRIGGER) -->
      <div class="timeline-visual-side">
        <img src="/images/ney-clinica-otimizado.webp" alt="Ney Felipe" class="timeline-speaker-photo" />
        <div class="timeline-line-container">
          <div class="timeline-scroll-line" id="timeline-fill-line"></div>
          <div class="timeline-dot dot-1 active"></div>
          <div class="timeline-dot dot-2"></div>
          <div class="timeline-dot dot-3"></div>
          <div class="timeline-dot dot-4"></div>
        </div>
      </div>

      <!-- Right side: Content blocks -->
      <div class="timeline-content-side">
        <h2 class="section-title">Programação do Dia {EVENT_DATE}</h2>
        <p class="section-sub" style="margin-bottom: 32px;">Um dia inteiro de conteúdo prático e voltado para a sua atuação em consultório:</p>
        
        <div class="timeline-content-block" id="timeline-block-1">
          <div class="block-num">09h00 às 12h00</div>
          <h3>Emagrecimento Além das Calorias</h3>
          <p><strong>Palestrante: Ney Felipe</strong><br/>
          O mito da calculoterapia e o que a ciência diz. Condutas práticas para diferentes perfis de paciente, periodização do acompanhamento nutricional e como aumentar a adesão sem depender de força de vontade.</p>
        </div>

        <div class="timeline-content-block" id="timeline-block-2">
          <div class="block-num">12h00 às 13h00</div>
          <h3>Intervalo para Almoço</h3>
          <p>Momento de pausa para descanso e recarregamento para o conteúdo da tarde.</p>
        </div>

        <div class="timeline-content-block" id="timeline-block-3">
          <div class="block-num">13h00 às 17h00</div>
          <h3>GLP-1, Canetas Emagrecedoras e Compostos Bioativos</h3>
          <p><strong>Palestrante: Jéssica Wszolek</strong><br/>
          Indicações clínicas e manejo dietético de canetas emagrecedoras. Compostos bioativos que ampliam os resultados, como orientar e acompanhar pacientes em uso de GLP-1 e prevenção de recaídas pós-medicação.</p>
        </div>

        <div class="timeline-content-block" id="timeline-block-4">
          <div class="block-num">17h00 às 18h00</div>
          <h3>Casos Clínicos e Perguntas ao Vivo</h3>
          <p><strong>Palestrantes: Ney Felipe & Jéssica Wszolek</strong><br/>
          Análise conjunta de casos clínicos reais de consultório e respostas imediatas às maiores dúvidas de atendimento dos alunos ao vivo.</p>
        </div>

        <!-- Mas você pode falhar alert block -->
        <div class="timeline-alert-block">
          <div class="alert-header">⚠️ Mas você pode falhar miseravelmente se:</div>
          <ul class="alert-list">
            <li>Apenas repetir "é só fechar a boca e fazer déficit calórico" no papel...</li>
            <li>Não souber orientar o manejo de efeitos colaterais de canetas de GLP-1...</li>
            <li>Tentar aplicar estratégias restritivas para pacientes altamente inflamados...</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       O QUE VOCÊ VAI APRENDER (MÓDULOS DE MASKING/REVEALING)
       ══════════════════════════════════════ -->
  <section class="section-modulos" id="conteudo">
    <div class="container">
      <h2 class="section-title text-center">Conteúdo do Treinamento</h2>
      <p class="section-sub text-center" style="max-width: 600px; margin: 0 auto 40px;">
        Os 7 passos estruturados para destravar seu raciocínio de consultório.
      </p>

      <div class="modulos-grid">
        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">01</span>
            <h3>Planejamento da Conduta Clínica</h3>
          </div>
          <p>Organização da primeira consulta, definição de objetivos realistas e mapeamento metabólico inicial do paciente.</p>
        </div>

        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">02</span>
            <h3>Fisiologia do Tecido Adiposo</h3>
          </div>
          <p>Entendendo a inflamação de baixo grau, mitocôndrias, regulação neuroendócrina do apetite e saciedade na prática.</p>
        </div>

        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">03</span>
            <h3>Manejo Prático de Canetas Emagrecedoras</h3>
          </div>
          <p>Protocolos dietéticos em conjunto com uso de análogos de GLP-1, controle de efeitos colaterais e prevenção de desnutrição.</p>
        </div>

        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">04</span>
            <h3>Compostos Bioativos e Suplementação</h3>
          </div>
          <p>Prescrição científica de fitoquímicos, antioxidantes e nutrientes específicos para acelerar a oxidação de gorduras.</p>
        </div>

        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">05</span>
            <h3>Estratégias de Adesão e Sustentabilidade</h3>
          </div>
          <p>Psicologia comportamental, como contornar os furos na dieta e criar planos alimentares sustentáveis.</p>
        </div>

        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">06</span>
            <h3>Periodização e Platô de Emagrecimento</h3>
          </div>
          <p>O que fazer quando o paciente para de emagrecer: quebra de platô metabólico e reajustes calóricos estratégicos.</p>
        </div>

        <div class="modulo-item">
          <div class="modulo-header">
            <span class="mod-num">07</span>
            <h3>Discussão de Casos Clínicos ao Vivo</h3>
          </div>
          <p>Casos práticos de consultório resolvidos passo a passo, abrindo espaço para suas dúvidas de atendimento.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       TIME / PALESTRANTES
       ══════════════════════════════════════ -->
  <section class="section-professores" id="time">
    <div class="container">
      <h2 class="section-title text-center">Aprenda Com Quem Vive a Prática</h2>
      
      <div class="professores-grid">
        <div class="professor-card">
          <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" class="prof-photo" />
          <div class="prof-info">
            <h3>NEY FELIPE</h3>
            <span class="prof-tag">Nutricionista e Mestre em Biol. Molecular</span>
            <p>19 anos de consultório clínico, pioneiro da Nutrição Funcional Esportiva no Brasil e fundador da Nutrição Avançada.</p>
          </div>
        </div>

        <div class="professor-card">
          <img src="/images/jessica.webp" alt="Jéssica Wszolek" class="prof-photo" />
          <div class="prof-info">
            <h3>JÉSSICA WSZOLEK</h3>
            <span class="prof-tag">Professora Convidada</span>
            <p>Referência nacional em manejo dietético integrado ao uso de análogos de GLP-1 e modulação do emagrecimento prático.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       OFERTA E ANCORAGEM DE PREÇO (COMPARAÇÃO ESCURA E VERMELHA)
       ══════════════════════════════════════ -->
  <section class="section-oferta" id="preco">
    <div class="container">
      <h2 class="section-title text-center">Garanta Sua Vaga no Lote Zero</h2>
      
      <div class="pricing-container-grid">
        <!-- Ingresso Básico -->
        <div class="pricing-card">
          <div class="card-header">
            <h3>Ingresso Básico</h3>
            <p>Ideal para assistir ao vivo</p>
          </div>
          <div class="card-divider"></div>
          <ul class="card-features">
            <li>✓ Acesso ao dia de Imersão ao vivo via Zoom</li>
            <li>✓ 8 horas de conteúdo intenso e aplicável</li>
            <li>✓ Grupo exclusivo de participantes</li>
            <li>✓ Materiais compartilhados no evento</li>
            <li>✓ Mini Curso Fundamentos do Emagrecimento</li>
          </ul>
          <div class="card-divider"></div>
          <div class="card-price-block">
            <span class="old-price">De R$ 97,00</span>
            <div class="current-price">{PRICE_BASICO}</div>
          </div>
          <button class="btn-purchase" data-form="normal">
            COMPRAR INGRESSO BÁSICO 🎟
          </button>
        </div>

        <!-- Ingresso VIP -->
        <div class="pricing-card pricing-card--vip">
          <div class="vip-highlight-badge">RECOMENDADO</div>
          <div class="card-header">
            <h3>Ingresso VIP</h3>
            <p class="text-glow">Gravação + Bônus Exclusivos</p>
          </div>
          <div class="card-divider"></div>
          <ul class="card-features">
            <li><strong>✓ Tudo do ingresso básico</strong></li>
            <li><strong>✓ Gravação do evento por 1 ano</strong></li>
            <li>✓ Certificado de participação de 8 horas</li>
            <li>✓ E-book Tópicos Avançados (R$ 99)</li>
            <li>✓ E-book "Me Formei, e agora?" (R$ 59)</li>
            <li>✓ E-book Desaprendendo a Dieta (R$ 39)</li>
            <li>✓ Ressaca do Evento (Encontro Extra no Zoom)</li>
            <li>✓ <strong>Cashback integral</strong> na Formação/Pós</li>
          </ul>
          <div class="card-divider"></div>
          <div class="card-price-block">
            <span class="old-price">De R$ 297,00</span>
            <span class="installment-label">POR APENAS:</span>
            <div class="current-price text-red">{PRICE_VIP}</div>
          </div>
          <button class="btn-purchase btn-purchase--vip" data-form="vip">
            COMPRAR INGRESSO VIP 🚀
          </button>
        </div>
      </div>

      <!-- Garantia -->
      <div class="garantia-global-block">
        <strong>🛡 Garantia Incondicional de 7 Dias</strong>
        <p>Você pode garantir sua vaga, assistir à imersão e, se sentir que o conteúdo não agregou para a sua prática, devolvemos 100% do seu dinheiro sem burocracia ou ressentimentos.</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       FAQ Accordion
       ══════════════════════════════════════ -->
  <section class="section-faq">
    <div class="container faq-inner">
      <h2 class="section-title text-center">Perguntas Frequentes</h2>

      <div class="faq-list" id="faq-list">
        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">
            <span>Para quem é a imersão?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Para nutricionistas e estudantes de nutrição que querem se diferenciar no tratamento do sobrepeso e obesidade, utilizando a ciência prática e o manejo farmacológico integrado.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">
            <span>Vai ficar gravado?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Apenas o Ingresso VIP dá acesso completo às gravações do evento por 1 ano. O ingresso Básico permite assistir somente ao vivo via Zoom no dia do evento.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">
            <span>Qual a política de cancelamento?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Você tem reembolso total assegurado por lei em até 7 dias após a compra, sem qualquer questionamento.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-btn" aria-expanded="false">
            <span>Como funciona o Cashback?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>O valor integral investido no Ingresso VIP (R$ 147) é revertido em desconto ao se matricular em nossa Formação completa de Nutrição Avançada ou em nossa Pós-Graduação Oficial.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal de Formulário GHL -->
  <FormModal />

  <!-- Lightbox Modal Container for screenshots zoom -->
  <div id="lightbox-modal" class="lightbox-overlay" style="display:none;">
    <button class="lightbox-close" id="lightbox-close" aria-label="Fechar">&times;</button>
    <img id="lightbox-img" src="" alt="Depoimento Ampliado" class="lightbox-content-img" />
  </div>

  <!-- ══════════════════════════════════════
       STICKY BOTTOM BAR (FADES IN SMOOTHLY ON SCROLL)
       ══════════════════════════════════════ -->
  <div class="sticky-bottom-bar" id="sticky-bar">
    <div class="container sticky-bar-inner">
      <div class="sticky-left">
        <a href="#preco" class="btn-sticky-action">
          Comprar ingresso | {LOTE} 🎟
        </a>
      </div>
      <div class="sticky-right">
        <div class="sticky-progress-container">
          <div class="sticky-progress-track">
            <div class="sticky-progress-fill" style="width: 78%;">
              <span class="sticky-progress-dot"></span>
            </div>
          </div>
          <span class="sticky-progress-label">
            78% dos ingressos vendidos · de R$ 97,00 por <strong class="red-price">{PRICE_BASICO}</strong>
          </span>
        </div>
      </div>
    </div>
  </div>

</Layout>

<!-- ══════════════════════════════════════
     SCRIPTS
     ══════════════════════════════════════ -->
<script>
  // FAQ Accordion (Rotate 45 deg added)
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Fechar todos
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('active');
        const b = i.querySelector('.faq-btn');
        const a = i.querySelector('.faq-answer') as HTMLElement;
        const ic = i.querySelector('.faq-icon');
        if (b) b.setAttribute('aria-expanded', 'false');
        if (a) a.style.maxHeight = '0';
        if (ic) ic.textContent = '+';
      });

      // Abrir o clicado
      if (!isOpen && item) {
        item.classList.add('active');
        const answer = item.querySelector('.faq-answer') as HTMLElement;
        const icon = item.querySelector('.faq-icon');
        btn.setAttribute('aria-expanded', 'true');
        if (answer) answer.style.maxHeight = answer.scrollHeight + 'px';
        if (icon) icon.textContent = '+'; // Keep "+" because rotate (45deg) transforms it to "x"
      }
    });
  });

  // Lightbox Modal Logic for Screenshots
  const lightbox = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('[data-zoom-img]').forEach(card => {
    card.addEventListener('click', () => {
      const src = (card as HTMLElement).dataset.zoomImg;
      if (src && lightbox && lightboxImg) {
        lightboxImg.src = src;
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    if (lightbox) lightbox.style.display = 'none';
    if (lightboxImg) lightboxImg.src = '';
    document.body.style.overflow = '';
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // STICKY BOTTOM BAR SCROLL LOGIC
  const stickyBar = document.getElementById('sticky-bar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 450) {
      stickyBar?.classList.add('sticky-bottom-bar--visible');
    } else {
      stickyBar?.classList.remove('sticky-bottom-bar--visible');
    }
  });

  // TIMELINE SCROLL LOGIC
  const fillLine = document.getElementById('timeline-fill-line');
  const dots = document.querySelectorAll('.timeline-dot');
  const blocks = document.querySelectorAll('.timeline-content-block');
  
  window.addEventListener('scroll', () => {
    const triggerPoint = window.innerHeight * 0.7;
    blocks.forEach((block, idx) => {
      const rect = block.getBoundingClientRect();
      if (rect.top < triggerPoint) {
        block.classList.add('active');
        dots[idx]?.classList.add('active');
        
        // Progress fill calculation
        const percent = ((idx + 1) / blocks.length) * 100;
        if (fillLine) fillLine.style.height = `${percent}%`;
      } else {
        block.classList.remove('active');
        if (idx > 0) dots[idx]?.classList.remove('active');
      }
    });
  });

  // MASKING / REVEALING OBSERVER (O que você vai aprender modules)
  const moduleObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });
  
  document.querySelectorAll('.modulo-item').forEach(item => {
    moduleObserver.observe(item);
  });
</script>

