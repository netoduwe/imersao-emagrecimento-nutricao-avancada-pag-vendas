---
import Layout from '../layouts/Layout.astro';
import FormModal from '../components/FormModal.astro';
import '../styles/imersao-v3.css';

const EVENT_DATE = '01 de Agosto de 2026';
const EVENT_TIME = '9h às 18h';
const PRICE_BASICO = 'R$ 19,90';
const PRICE_VIP_PARCELADO = '12x de R$ 15,20';
const PRICE_VIP_AVISTA = 'R$ 147,00';
---

<Layout title={`Imersão em Emagrecimento | ${EVENT_DATE} | Nutrição Avançada`} theme="green" hideHeader={true}>
  <main class="case-page">
    
    <!-- ══════════════════════════════════════
         HERO — ESTUDO DE CASO PREMIUM (V3 DARK & RED)
         ══════════════════════════════════════ -->
    <section class="case-hero" id="imersao">
      <div class="case-shell case-hero__grid">
        <div class="case-hero__content">
          <p class="case-kicker">5ª Edição · Imersão em Emagrecimento</p>
          <h1>
            Trate a obesidade e o emagrecimento com base em dados.
            <span>E fisiologia clínica consolidada.</span>
          </h1>
          <p class="case-lead">
            Um dia inteiro destravando o raciocínio clínico que você precisa para atender com segurança e entregar resultados duradouros para seus pacientes.
          </p>

          <div class="case-hero__actions">
            <div class="case-hero__ticket" aria-label="Ingresso lote zero">
              <span class="case-hero__lot">Lote zero</span>
              <p>De <s>R$ 97,00</s> por apenas</p>
              <strong>{PRICE_BASICO}</strong>
              <a href="#ingressos" class="case-hero__buy">Garantir minha vaga! &gt;</a>
              <small>Garantia incondicional de 7 dias · Sem burocracia</small>
            </div>
          </div>

          <div class="case-hero__facts" aria-label="Dados do evento">
            <span>{EVENT_DATE}</span>
            <span>{EVENT_TIME}</span>
            <span>Online via Zoom</span>
          </div>
        </div>

        <div class="case-hero__visual" aria-label="Palestrantes da imersão">
          <div class="case-photo-stack">
            <figure class="case-photo case-photo--ney">
              <img src="/images/ney-clinica-otimizado.webp" alt="Prof. Ney Felipe" />
              <figcaption>Ney Felipe · conduta clínica</figcaption>
            </figure>
            <figure class="case-photo case-photo--jessica">
              <img src="/images/jessica.webp" alt="Profa. Jéssica Wszolek" />
              <figcaption>Jéssica Wszolek · GLP-1</figcaption>
            </figure>
          </div>
          <div class="case-stamp" style="background: rgba(227, 75, 63, 0.85); color: #fff; border-color: rgba(227, 75, 63, 0.4);">Ao vivo<br />Zoom</div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         TICKER DE CAMPANHA
         ══════════════════════════════════════ -->
    <section class="case-strip" aria-label="Resumo da virada de campanha">
      <div class="case-strip__track" style="animation: caseScroll 22s linear infinite;">
        <span>lote zero ativo</span>
        <span>conduta além da calculadora</span>
        <span>gravação por 1 ano no VIP</span>
        <span>01 agosto 2026</span>
        <span>lote zero ativo</span>
        <span>conduta além da calculadora</span>
        <span>gravação por 1 ano no VIP</span>
        <span>01 agosto 2026</span>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         01 / CASO CLÍNICO
         ══════════════════════════════════════ -->
    <section class="case-shell case-problem" id="caso">
      <div class="case-section-mark" style="color: var(--case-red);">01 / caso clínico</div>
      <div class="case-problem__grid">
        <div>
          <h2>O paciente de emagrecimento virou um caso mais complexo:</h2>
          <p>
            O paciente não chega mais só perguntando por dieta. Ele chega usando GLP-1 (como Ozempic e Mounjaro), comendo pouco,
            perdendo massa magra, travando no platô ou com medo de recuperar peso quando retirar a medicação.
          </p>
        </div>
        <div class="case-notes" aria-label="Sintomas clínicos da página" style="border-left-color: var(--case-red);">
          <p><strong>Queixa 01</strong> "Meu apetite sumiu, mas estou sem força."</p>
          <p><strong>Queixa 02</strong> "Emagreci, mas perdi massa magra junto."</p>
          <p><strong>Queixa 03</strong> "Vou parar a caneta. E agora?"</p>
          <p><strong>Queixa 04</strong> "Doutora, por que eu parei de evoluir?"</p>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         02 / EVIDÊNCIAS DE MERCADO
         ══════════════════════════════════════ -->
    <section class="case-evidence" id="evidencias">
      <div class="case-shell">
        <div class="case-section-mark" style="color: var(--case-red);">02 / evidências de mercado</div>
        <div class="evidence-board">
          <article class="evidence-item evidence-item--lead" style="border-top-color: var(--case-red);">
            <span>Google Trends & mercado</span>
            <h3>O Brasil ocupa a <mark style="background: rgba(227, 75, 63, 0.25); color: #fff;">2ª posição mundial</mark> nas buscas por Ozempic e Mounjaro na internet.</h3>
            <p>
              A procura massiva por canetas emagrecedoras movimentou mais de R$ 10 bilhões no mercado nacional, gerando uma onda inédita de pacientes necessitando de suporte nutricional no consultório.
            </p>
            <a href="#ingressos" class="evidence-cta" style="color: var(--case-red); border-color: var(--case-red);">Selecionar ingresso</a>
          </article>

          <article class="evidence-item" style="border-top-color: var(--case-line);">
            <span>Adesão</span>
            <h3>Mais de <mark style="background: rgba(227, 75, 63, 0.15); color: #fff;">45% abandonam</mark> GLP-1 no primeiro ano.</h3>
            <p>Efeitos gastrointestinais severos, perda de massa magra e falta de estratégia nutricional integrada pesam no abandono.</p>
          </article>

          <article class="evidence-item" style="border-top-color: var(--case-line);">
            <span>Projeções 2030</span>
            <h3><mark style="background: rgba(227, 75, 63, 0.15); color: #fff;">68% dos brasileiros</mark> estarão com excesso de peso.</h3>
            <p>Não é nicho. O avanço do sobrepeso exige condutas clínicas modernas. Tratar emagrecimento apenas calculando déficit calórico faliu.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         03 / ANTES DA IMERSÃO (PUbMED CHAOS)
         ══════════════════════════════════════ -->
    <section class="case-overload">
      <div class="case-shell overload-grid">
        <div class="overload-copy">
          <div class="case-section-mark" style="color: var(--case-red);">03 / antes da imersão</div>
          <h2>Você já perdeu tempo demais tentando montar esse raciocínio sozinho.</h2>
          <p>
            Uma aba com artigo. Outra com diretriz. Um post salvo no Instagram. Um print no WhatsApp.
            No fim, você estudou muito, mas ainda precisa transformar tudo isso em conduta para o paciente real.
          </p>
          <p class="overload-callout" style="color: var(--case-red); background: rgba(227, 75, 63, 0.08); border-left-color: var(--case-red);">
            Isso pode ser organizado em um dia de imersão comigo.
          </p>
        </div>

        <div class="browser-chaos" aria-label="Representação visual de abas, artigos e posts salvos">
          <div class="browser-window browser-window--main" style="border-color: var(--case-line);">
            <div class="browser-tabs" style="border-bottom-color: var(--case-line);">
              <span style="border-right-color: var(--case-line); color: var(--case-red);">PubMed</span>
              <span style="border-right-color: var(--case-line);">GLP-1</span>
              <span style="border-right-color: var(--case-line);">proteína</span>
              <span>diretriz</span>
            </div>
            <div class="browser-search" style="border-bottom-color: var(--case-line);">semaglutide nutrition lean mass clinical practice...</div>
            <div class="article-lines">
              <i></i><i></i><i></i><i></i>
            </div>
          </div>
          <div class="browser-window browser-window--post" style="border-color: rgba(227, 75, 63, 0.35); background: #1a0808;">
            <span class="post-tag" style="background: var(--case-red); color: #140202;">post salvo</span>
            <strong>"5 dicas para paciente em uso de caneta"</strong>
            <small>parece simples, mas não fecha a conduta</small>
          </div>
          <div class="browser-window browser-window--note" style="border-color: var(--case-line);">
            <strong>Prontuário</strong>
            <span>Náusea + baixa proteína + treino fraco</span>
            <span>Como ajustar sem piorar sintomas?</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         04 / SALA DE AULA (CONTEÚDO E CRONOGRAMA)
         ══════════════════════════════════════ -->
    <section class="case-shell case-method" id="aula">
      <div class="case-section-mark" style="color: var(--case-red);">04 / sala de aula</div>
      <div class="case-method__headline">
        <h2>O que você vai aprender na Imersão</h2>
        <p>O dia foi organizado para transformar conteúdo técnico em conduta: avaliação, estratégia, prescrição e acompanhamento.</p>
      </div>

      <div class="lecture-map">
        <article style="border-top-color: var(--case-red);">
          <span style="color: var(--case-red);">Bloco Ney</span>
          <h3>Períodos críticos</h3>
          <p>Como conduzir adesão, platô e reganho de peso sem reduzir o acompanhamento ao déficit calórico.</p>
        </article>
        <article style="border-top-color: var(--case-line);">
          <span style="color: var(--case-red);">Bloco Ney</span>
          <h3>Alvos moleculares</h3>
          <p>Quais prioridades fisiológicas entram na dietoterapia para emagrecimento e como organizar a proposta terapêutica.</p>
        </article>
        <article style="border-top-color: var(--case-line);">
          <span style="color: var(--case-red);">Bloco Jéssica</span>
          <h3>GLP-1 e massa magra</h3>
          <p>Como ajustar proteína, suplementação, sintomas gastrointestinais e monitoramento clínico quando o apetite despenca.</p>
        </article>
        <article style="border-top-color: var(--case-line);">
          <span style="color: var(--case-red);">Conduta integrada</span>
          <h3>Bioativos e mediterrânea</h3>
          <p>Como aplicar alimentos funcionais, compostos bioativos e dieta mediterrânea de forma prática e individualizada.</p>
        </article>
      </div>

      <div class="case-schedule" aria-label="Cronograma" style="border-top-color: var(--case-line); border-bottom-color: var(--case-line);">
        <div><time style="color: var(--case-red);">09h30</time><span>Abertura e raciocínio inicial (Zoom ao vivo)</span></div>
        <div style="border-left-color: var(--case-line);"><time style="color: var(--case-red);">12h00</time><span>Intervalo de almoço</span></div>
        <div style="border-left-color: var(--case-line);"><time style="color: var(--case-red);">13h30</time><span>Blocos técnicos e estudos de casos</span></div>
        <div style="border-left-color: var(--case-line);"><time style="color: var(--case-red);">17h30</time><span>Encerramento previsto</span></div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         05 / PROVA REAL
         ══════════════════════════════════════ -->
    <section class="case-proof">
      <div class="case-shell proof-grid">
        <div class="case-section-mark" style="color: var(--case-red);">05 / prova real</div>
        <div class="proof-copy">
          <h2>Quem participou saiu com mais clareza para atender.</h2>
          <p>
            A edição anterior deixou um sinal importante: o valor percebido veio da aplicação.
            Nutricionistas relataram mais segurança para raciocinar, explicar e conduzir o paciente.
          </p>
        </div>

        <div class="proof-wall">
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_1.png" style="cursor: pointer;">
            <img src="/images/depoimentos/Screenshot_1.png" alt="Depoimento real de participante" style="border: 1px solid var(--case-line); transition: transform 0.2s;" />
          </div>
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_3.png" style="cursor: pointer;">
            <img src="/images/depoimentos/Screenshot_3.png" alt="Depoimento real de participante" style="border: 1px solid var(--case-line); transition: transform 0.2s;" />
          </div>
          <div class="screenshot-card" data-zoom-img="/images/depoimentos/Screenshot_14.png" style="cursor: pointer;">
            <img src="/images/depoimentos/Screenshot_14.png" alt="Depoimento real de participante" style="border: 1px solid var(--case-line); transition: transform 0.2s;" />
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         05.1 / MID CTA
         ══════════════════════════════════════ -->
    <section class="case-mid-cta">
      <div class="case-shell case-mid-cta__grid">
        <div class="case-mid-cta__copy">
          <div class="case-section-mark" style="color: var(--case-red);">05.1 / garantir vaga</div>
          <h2>Se a decisão já faz sentido, aqui está o lote que está valendo agora.</h2>
          <p>
            Você não precisa esperar chegar no final da página para travar esse preço.
            O lote zero ainda está ativo, com garantia de 7 dias e acesso imediato à confirmação da vaga.
          </p>
        </div>

        <div class="case-mid-cta__card">
          <div class="case-hero__ticket" aria-label="Ingresso lote zero" style="border-color: rgba(227, 75, 63, 0.55); background: linear-gradient(135deg, rgba(227, 75, 63, 0.13), transparent 44%), #130303; box-shadow: 10px 10px 0 rgba(227, 75, 63, 0.11);">
            <span class="case-hero__lot" style="background: var(--case-red); color: #140202;">Lote zero</span>
            <p>De <s>R$ 97,00</s> por apenas</p>
            <strong>{PRICE_BASICO}</strong>
            <a href="#ingressos" class="case-hero__buy" style="background: var(--case-red); color: #140202;">Garantir minha vaga! &gt;</a>
            <small>Garantia incondicional de 7 dias · Sem burocracia</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         06 / INGRESSOS / COMPARAÇÃO
         ══════════════════════════════════════ -->
    <section class="case-shell case-tickets" id="ingressos">
      <div class="case-section-mark" style="color: var(--case-red);">06 / acesso</div>
      <div class="ticket-intro">
        <h2>Escolha seu formato de ingresso</h2>
      </div>

      <div class="ticket-board">
        <!-- BÁSICO -->
        <article class="ticket ticket--basic" style="border-color: var(--case-line); background: #0c0505;">
          <div class="ticket__edge" style="background: var(--case-line); color: var(--case-muted);">Básico</div>
          <h3>Ingresso ao vivo</h3>
          <p class="ticket__old">De R$ 97,00 por</p>
          <p class="ticket__price">{PRICE_BASICO}</p>
          <ul>
            <li>Acesso ao dia de imersão ao vivo via Zoom</li>
            <li>Grupo exclusivo de participantes</li>
            <li>Materiais compartilhados na aula</li>
            <li>Mini Curso Fundamentos do Emagrecimento</li>
          </ul>
          <a href="#" data-form="normal" class="ticket__button" style="border-color: var(--case-line); color: #fff; background: transparent;">Comprar básico</a>
        </article>

        <!-- VIP -->
        <article class="ticket ticket--vip" style="border-color: rgba(227, 75, 63, 0.55); background: linear-gradient(135deg, rgba(227, 75, 63, 0.08), transparent 45%), #130303; box-shadow: 10px 10px 0 rgba(227, 75, 63, 0.09);">
          <div class="ticket__edge" style="background: var(--case-red); color: #140202;">VIP</div>
          <h3>Acesso completo</h3>
          <p class="ticket__old">De R$ 297,00 por</p>
          <p class="ticket__price">{PRICE_VIP_PARCELADO}</p>
          <p class="ticket__cash">ou {PRICE_VIP_AVISTA} à vista</p>
          <div class="ticket-details">
            <details class="ticket-feature">
              <summary>&gt; Tudo do básico + <span>ver o que é</span></summary>
              <p>Evento ao vivo, grupo do evento, materiais compartilhados e base para acompanhar a imersão com aplicação imediata.</p>
            </details>
            <details class="ticket-feature ticket-feature--static" open>
              <summary>Gravação do evento <span style="background: var(--case-red); color: #140202;">por 1 ano</span></summary>
            </details>
            <details class="ticket-feature">
              <summary>&gt; Certificado de 8h <span>ver benefício</span></summary>
              <p>Para contabilizar horas na faculdade ou sinalizar ao paciente que sua conduta continua em evolução.</p>
            </details>
            <details class="ticket-feature">
              <summary>&gt; E-book Tópicos Avançados <span style="color: var(--case-red); font-weight: 700;">(R$ 99)</span></summary>
              <p>Nutricosméticos, crononutrição e biogênese mitocondrial com ligação entre teoria, prescrição e prática.</p>
            </details>
            <details class="ticket-feature">
              <summary>&gt; Ebook "Me Formei, e agora?" <span style="color: var(--case-red); font-weight: 700;">(R$ 59)</span></summary>
              <p>Respostas para precificação, retorno, fidelização, sublocação de sala e outras dúvidas da rotina profissional.</p>
            </details>
            <details class="ticket-feature">
              <summary>&gt; Ebook Desaprendendo a Dieta <span style="color: var(--case-red); font-weight: 700;">(R$ 39)</span></summary>
              <p>Material de educação nutricional para o paciente sair da dependência de mito, regra rasa e mentalidade de dieta.</p>
            </details>
            <details class="ticket-feature">
              <summary>&gt; Ressaca do Evento <span>ver benefício</span></summary>
              <p>Encontro extra no Zoom para revisar a aula, recapitular os pontos principais e abrir espaço para dúvidas pós-imersão.</p>
            </details>
            <details class="ticket-feature">
              <summary>&gt; Cashback integral <span>ver como funciona</span></summary>
              <p>O valor investido no VIP volta como desconto se você entrar depois na Formação Nutrição Avançada ou na Pós-Graduação.</p>
            </details>
          </div>
          <a href="#" data-form="vip" class="ticket__button" style="background: var(--case-red); color: #140202;">Comprar VIP</a>
        </article>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FAQ / ACCORDION CLEAN
         ══════════════════════════════════════ -->
    <section class="case-faq">
      <div class="case-shell faq-grid">
        <h2>Perguntas frequentes</h2>
        <div class="faq-list">
          <details style="border-bottom-color: var(--case-line);">
            <summary style="color: #fff;">Para quem é essa imersão?</summary>
            <p style="color: var(--case-muted);">Nutricionistas formados e estudantes que querem atender emagrecimento com mais raciocínio clínico, especialmente em casos com GLP-1, platô, adesão e reganho.</p>
          </details>
          <details style="border-bottom-color: var(--case-line);">
            <summary style="color: #fff;">Vai ficar gravado?</summary>
            <p style="color: var(--case-muted);">O ingresso VIP dá acesso completo às gravações por 1 ano. O básico é para acompanhar ao vivo.</p>
          </details>
          <details style="border-bottom-color: var(--case-line);">
            <summary style="color: #fff;">Tem garantia?</summary>
            <p style="color: var(--case-muted);">Sim. Você tem 7 dias de garantia incondicional, sem burocracia.</p>
          </details>
          <details style="border-bottom-color: var(--case-line);">
            <summary style="color: #fff;">Como funciona o Cashback?</summary>
            <p style="color: var(--case-muted);">O valor integral investido no Ingresso VIP (R$ 147) é revertido em desconto ao se matricular na Formação completa de Nutrição Avançada ou na Pós-Graduação Oficial.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FINAL CTA
         ══════════════════════════════════════ -->
    <section class="case-final" style="background: linear-gradient(180deg, transparent, rgba(227, 75, 63, 0.08)), #070202; border-top-color: var(--case-line);">
      <div class="case-shell">
        <p style="color: var(--case-red); font-weight: 700;">01 de Agosto · Online via Zoom · Lote zero ativo</p>
        <h2>A próxima consulta de emagrecimento pode ter mais raciocínio e menos improviso.</h2>
        <a href="#ingressos" class="case-action case-action--primary" style="background: var(--case-red); color: #140202; border-color: var(--case-red); box-shadow: 8px 8px 0 #381414;">Escolher ingresso</a>
      </div>
    </section>

  </main>

  <FormModal />

  <!-- Lightbox Modal Container for screenshots zoom -->
  <div id="lightbox-modal" class="lightbox-overlay" style="display:none;">
    <button class="lightbox-close" id="lightbox-close" aria-label="Fechar">&times;</button>
    <img id="lightbox-img" src="" alt="Depoimento Ampliado" class="lightbox-content-img" />
  </div>

  <!-- STICKY BOTTOM BAR (FADES IN SMOOTHLY ON SCROLL) -->
  <div class="sticky-bottom-bar" id="sticky-bar">
    <div class="container sticky-bar-inner">
      <div class="sticky-left">
        <a href="#ingressos" class="btn-sticky-action">
          Comprar ingresso | Lote zero 🎟
        </a>
      </div>
      <div class="sticky-right">
        <div class="sticky-progress-container">
          <span class="sticky-progress-label">
            Garantia de 7 dias · Acesso imediato · Ingresso a partir de <strong class="red-price">{PRICE_BASICO}</strong>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox e Sticky Bar Script -->
  <script>
    // Lightbox Modal Logic for Screenshots
    const lightbox = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');

    document.querySelectorAll('[data-zoom-img]').forEach(card => {
      card.addEventListener('click', () => {
        const src = (card as HTMLElement).dataset.zoomImg;
        if (src && lightbox && lightboxImg) {
          lightboxImg.src = src;
          lightbox.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    });

    function closeLightbox() {
      if (lightbox) lightbox.style.display = 'none';
      if (lightboxImg) lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // STICKY BOTTOM BAR SCROLL LOGIC
    const stickyBar = document.getElementById('sticky-bar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 450) {
        stickyBar?.classList.add('sticky-bottom-bar--visible');
      } else {
        stickyBar?.classList.remove('sticky-bottom-bar--visible');
      }
    });
  </script>

</Layout>
