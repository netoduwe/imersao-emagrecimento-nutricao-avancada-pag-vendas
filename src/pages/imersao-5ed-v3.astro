---
import Layout from '../layouts/Layout.astro';
import FormModal from '../components/FormModal.astro';
import T9Tracking from '../components/T9Tracking.astro';
import OfferUrgencyBar from '../components/OfferUrgencyBar.astro';
import { IMERSAO_5ED_CURRENT_LOT, IMERSAO_5ED_PRICING } from '../config/imersao-5ed';
import '../styles/imersao-v3.css';

const EVENT_DATE = '01 de Agosto de 2026';
const EVENT_DATE_SHORT = '01 Ago 2026';
const EVENT_TIME = '9h às 18h';
const LOTE = IMERSAO_5ED_CURRENT_LOT.label;
const PRICE_BASICO = IMERSAO_5ED_CURRENT_LOT.basicPrice;
const PRICE_VIP_PARCELADO = IMERSAO_5ED_PRICING.vipInstallments;
const PRICE_VIP_AVISTA = IMERSAO_5ED_PRICING.vipCash;
---

<Layout title={`Imersão em Emagrecimento — 5ª Edição | ${EVENT_DATE} | Nutrição Avançada`} theme="blue" hideHeader={true}>
  
  <style is:global>
    /* Forçar faixa preta e vermelha da urgência, vencendo qualquer CSS de layout global */
    .urgency-strip {
      background: #0a0a0a !important;
      color: #ffffff !important;
      border-bottom: 1.5px solid #dc2626 !important;
    }
    #lote-strip-badge {
      background: #dc2626 !important;
      color: #ffffff !important;
    }
    #countdown {
      color: #ef4444 !important;
    }
  </style>

  <div class="v3-page">

    <!-- ══════════════════════════════════════
         HERO
         ══════════════════════════════════════ -->
    <section class="v3-hero" id="imersao">
      <div class="v3-wrap v3-hero__grid">
        <div>
          <span class="v3-hero__edition">5ª Edição · Imersão em Emagrecimento</span>

          <h1 class="v3-hero__headline">
            Um dia inteiro aprendendo a <em>tratar o emagrecimento</em> com o que a ciência mais atual comprova.
          </h1>

          <p class="v3-hero__sub">
            Manejo de canetas emagrecedoras, compostos bioativos e prática clínica além do déficit calórico — com Ney Felipe e Jéssica Wszolek.
          </p>

          <div class="v3-hero__meta">
            <span>📅 {EVENT_DATE_SHORT}</span>
            <span>🕘 {EVENT_TIME}</span>
            <span>💻 Online via Zoom</span>
          </div>

          <div class="v3-hero__cta-group">
            <a href="#ingressos" class="v3-btn-primary">Ver opções de ingresso</a>
            <p class="v3-hero__price-hint">
              A partir de <strong>{PRICE_BASICO}</strong> · Garantia de 7 dias
            </p>
          </div>

          <OfferUrgencyBar ctaUrl="#ingressos" />
        </div>

        <div class="v3-hero__visual">
          <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" class="v3-hero__speaker-img" />
          <div class="v3-hero__speaker-badge"><strong>Ney Felipe</strong> · 19 anos de clínica</div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SOCIAL PROOF STRIP
         ══════════════════════════════════════ -->
    <section class="v3-proof-strip">
      <div class="v3-wrap v3-proof-strip__grid">
        <div class="v3-proof-stat">
          <span class="v3-proof-stat__number">70.1%</span>
          <span class="v3-proof-stat__label">superou as expectativas</span>
        </div>
        <div class="v3-proof-stat">
          <span class="v3-proof-stat__number">99.4%</span>
          <span class="v3-proof-stat__label">avaliação positiva</span>
        </div>
        <div class="v3-proof-stat">
          <span class="v3-proof-stat__number">174</span>
          <span class="v3-proof-stat__label">alunos avaliaram</span>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         O PROBLEMA
         ══════════════════════════════════════ -->
    <section class="v3-section" id="problema">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Você se sente seguro para tratar um paciente com sobrepeso?</h2>
        <p class="v3-section__sub">Com certeza você já enfrentou situações como essas no consultório:</p>

        <div class="v3-problem-grid">
          <div class="v3-problem-item">Paciente não adere ao plano alimentar e você não sabe por quê.</div>
          <div class="v3-problem-item">Insegurança para conduzir a consulta além das calorias.</div>
          <div class="v3-problem-item">Desatualizado sobre canetas emagrecedoras (GLP-1) e compostos bioativos.</div>
          <div class="v3-problem-item">Dificuldade para manejar pacientes pós-medicação sem recaída.</div>
          <div class="v3-problem-item">Não sabe como periodizar o acompanhamento corretamente.</div>
          <div class="v3-problem-item">Falta de ferramentas práticas para a consulta de emagrecimento.</div>
        </div>

        <blockquote class="v3-quote">
          "Embora o déficit calórico seja a condição <em>sine qua non</em> para emagrecer, <strong>a nutrição não se resume a uma simples calculoterapia.</strong>"
          <cite>— Ney Felipe</cite>
        </blockquote>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         MANCHETES / MERCADO
         ══════════════════════════════════════ -->
    <section class="v3-section">
      <div class="v3-wrap">
        <h2 class="v3-section__title">O mercado mudou. Quem não se atualizar, ficará para trás.</h2>
        <p class="v3-section__sub">As canetas emagrecedoras e a nova realidade da obesidade abriram uma oportunidade sem precedentes para nutricionistas que dominam a clínica avançada:</p>

        <div class="v3-market-grid">
          <div class="v3-market-card">
            <div class="v3-market-card__source">Google Trends & Levantamento Global</div>
            <h3 class="v3-market-card__title">
              Brasil ocupa a <mark>2ª posição mundial nas buscas por Ozempic e Mounjaro</mark> na internet.
            </h3>
            <p class="v3-market-card__desc">A procura massiva por canetas emagrecedoras movimentou mais de R$ 10 bilhões no mercado nacional.</p>
          </div>

          <div class="v3-market-card">
            <div class="v3-market-card__source">Estudos de Mundo Real (GLP-1)</div>
            <h3 class="v3-market-card__title">
              Mais de <mark>45% dos pacientes abandonam o uso de canetas de GLP-1</mark> no primeiro ano.
            </h3>
            <p class="v3-market-card__desc">Efeitos gastrointestinais severos e perda de massa magra são os principais motivos de abandono.</p>
          </div>

          <div class="v3-market-card">
            <div class="v3-market-card__source">Organização Mundial da Saúde</div>
            <h3 class="v3-market-card__title">
              Projeções alertam que até 2030, <mark>68% dos brasileiros estarão com excesso de peso</mark>.
            </h3>
            <p class="v3-market-card__desc">Tratar emagrecimento apenas calculando déficit calórico básico faliu.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         POR QUE UMA IMERSÃO
         ══════════════════════════════════════ -->
    <section class="v3-section">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Por que uma imersão de 1 dia muda sua prática clínica?</h2>
        <p class="v3-section__sub">Não é mais um curso de teoria. É um dia inteiro de imersão aplicada, com casos clínicos reais e os protocolos que o Ney usa depois de 19 anos de consultório.</p>

        <div class="v3-mechanism-grid">
          <div class="v3-mechanism-card">
            <div class="v3-mechanism-card__num">01</div>
            <h3>Imersão, não curso</h3>
            <p>9h de conteúdo intenso com profundidade real — não aulas gravadas que você esquece na semana seguinte.</p>
          </div>
          <div class="v3-mechanism-card">
            <div class="v3-mechanism-card__num">02</div>
            <h3>Prática clínica aplicada</h3>
            <p>Cada bloco termina com como aplicar amanhã na consulta — da conduta ao manejo de expectativas do paciente.</p>
          </div>
          <div class="v3-mechanism-card">
            <div class="v3-mechanism-card__num">03</div>
            <h3>Ciência atualizada</h3>
            <p>GLP-1, canetas emagrecedoras, compostos bioativos e neurofisiologia do comportamento — o que a literatura mais recente comprova.</p>
          </div>
          <div class="v3-mechanism-card">
            <div class="v3-mechanism-card__num">04</div>
            <h3>Especialistas de alto nível</h3>
            <p>Ney Felipe + Jéssica Wszolek — dois especialistas com vivência real nos temas que mais impactam o tratamento do sobrepeso hoje.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         PALESTRANTES
         ══════════════════════════════════════ -->
    <section class="v3-section" id="time">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Quem estará no palco virtual?</h2>
        <p class="v3-section__sub">Aprenda com quem está no campo de batalha clínico diariamente.</p>

        <div class="v3-speakers-grid">
          <div class="v3-speaker-card">
            <img src="https://nutrineyfelipe.com/wp-content/uploads/2024/06/ney-felipe-nutricionista.png" alt="Ney Felipe" class="v3-speaker-card__photo" />
            <div class="v3-speaker-card__info">
              <h3>Ney Felipe</h3>
              <span class="v3-speaker-card__tag">Nutricionista · Mestre em Biol. Molecular</span>
              <p>19 anos de consultório clínico, pioneiro da Nutrição Funcional Esportiva no Brasil e fundador da Nutrição Avançada.</p>
            </div>
          </div>

          <div class="v3-speaker-card">
            <img src="/images/jessica.webp" alt="Jéssica Wszolek" class="v3-speaker-card__photo" />
            <div class="v3-speaker-card__info">
              <h3>Jéssica Wszolek</h3>
              <span class="v3-speaker-card__tag">Professora Convidada</span>
              <p>Referência nacional em manejo dietético integrado ao uso de análogos de GLP-1 e modulação do emagrecimento prático.</p>
              <a href="https://www.youtube.com/shorts/vPnW2rWVQHY" target="_blank" class="v3-btn-secondary btn-ver-chamada">🎥 Ver chamada</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         CRONOGRAMA
         ══════════════════════════════════════ -->
    <section class="v3-section" id="cronograma">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Cronograma da Imersão</h2>
        <p class="v3-section__sub">Ambos os blocos do dia seguirão essa divisão de horários:</p>

        <div class="v3-schedule-list">
          <div class="v3-schedule-item">
            <span class="v3-schedule-time">09h30</span>
            <div class="v3-schedule-desc">
              <h3>Início do Evento</h3>
              <p>Boas-vindas e abertura da transmissão ao vivo via Zoom.</p>
            </div>
          </div>
          <div class="v3-schedule-item">
            <span class="v3-schedule-time">12h00</span>
            <div class="v3-schedule-desc">
              <h3>Intervalo para Almoço</h3>
              <p>Momento de pausa para almoço e descanso.</p>
            </div>
          </div>
          <div class="v3-schedule-item">
            <span class="v3-schedule-time">13h30</span>
            <div class="v3-schedule-desc">
              <h3>Retorno das Palestras</h3>
              <p>Reinício dos blocos técnicos de conteúdo prático.</p>
            </div>
          </div>
          <div class="v3-schedule-item">
            <span class="v3-schedule-time">17h30</span>
            <div class="v3-schedule-desc">
              <h3>Encerramento das Atividades*</h3>
              <p>*Pode encerrar mais tarde caso os participantes peçam aprofundamento.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         O QUE VOCÊ VAI APRENDER
         ══════════════════════════════════════ -->
    <section class="v3-section" id="conteudo">
      <div class="v3-wrap">
        <h2 class="v3-section__title">O Que Você Vai Aprender</h2>
        <p class="v3-section__sub">Todo o raciocínio clínico e as condutas de consultório estruturadas:</p>

        <div class="v3-content-grid">
          <div class="v3-content-column">
            <div class="v3-content-column__speaker">Conduta Clínica & Emagrecimento</div>
            <div class="v3-content-column__name">Prof. Ney Felipe</div>
            <ul class="v3-content-list">
              <li>Como conduzir o paciente durante os períodos críticos do emagrecimento (adesão, platô e reganho).</li>
              <li>Os alvos moleculares que o nutricionista precisa priorizar no acompanhamento nutricional.</li>
              <li>Como parar de tratar emagrecimento apenas como "déficit calórico".</li>
              <li>Como montar uma proposta terapêutica que vai além das calorias.</li>
              <li>Como aplicar alimentos funcionais e compostos bioativos para emagrecimento.</li>
              <li>Como aplicar a dieta mediterrânea no emagrecimento de forma prática e individualizada.</li>
              <li>Estudo de caso: como desenhar uma proposta terapêutica passo a passo.</li>
              <li>O Método Nutrição Avançada baseado em evidências para todas as fases do emagrecimento.</li>
            </ul>
          </div>
          <div class="v3-content-column">
            <div class="v3-content-column__speaker">Manejo Prático de GLP-1</div>
            <div class="v3-content-column__name">Profa. Jéssica Wszolek</div>
            <ul class="v3-content-list">
              <li>Por que as canetas emagrecedoras tornam o nutricionista ainda mais indispensável.</li>
              <li>O erro silencioso que faz o paciente perder massa magra — e como evitar na prática clínica.</li>
              <li>Como ajustar a dieta quando o apetite simplesmente desaparece com GLP-1.</li>
              <li>O que NUNCA ignorar em um paciente que usa GLP-1 para evitar fadiga e déficit proteico.</li>
              <li>Por que o desmame da medicação começa muito antes da retirada da caneta.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         DEPOIMENTOS
         ══════════════════════════════════════ -->
    <section class="v3-section">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Resultados e Avaliação da Última Edição</h2>
        <p class="v3-section__sub">Veja a opinião real de quem participou da edição anterior:</p>

        <div class="v3-testimonials-grid">
          <div class="v3-testimonial-card" data-zoom-img="/images/depoimentos/Screenshot_1.png">
            <img src="/images/depoimentos/Screenshot_1.png" alt="Depoimento de participante" loading="lazy" />
          </div>
          <div class="v3-testimonial-card" data-zoom-img="/images/depoimentos/Screenshot_3.png">
            <img src="/images/depoimentos/Screenshot_3.png" alt="Depoimento de participante" loading="lazy" />
          </div>
          <div class="v3-testimonial-card" data-zoom-img="/images/depoimentos/Screenshot_14.png">
            <img src="/images/depoimentos/Screenshot_14.png" alt="Depoimento de participante" loading="lazy" />
          </div>
          <div class="v3-testimonial-card" data-zoom-img="/images/depoimentos/Screenshot_23.png">
            <img src="/images/depoimentos/Screenshot_23.png" alt="Depoimento de participante" loading="lazy" />
          </div>
        </div>
        <p class="v3-testimonials-footer">Mensagens reais de quem participou da última edição da Imersão.</p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         INGRESSOS
         ══════════════════════════════════════ -->
    <section class="v3-section" id="ingressos">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Ingresso Básico vs Ingresso VIP</h2>
        <p class="v3-section__sub">{LOTE} ativo por tempo limitado. Escolha a melhor opção para a sua carreira.</p>

        <div class="v3-tickets-grid">
          <!-- Básico -->
          <div class="v3-ticket">
            <span class="v3-ticket__type">Básico</span>
            <h3>Ingresso ao vivo</h3>
            <ul class="v3-ticket__features">
              <li>Acesso ao dia de Imersão ao vivo via Zoom</li>
              <li>8 horas de conteúdo intenso</li>
              <li>Grupo exclusivo de participantes</li>
              <li>Materiais compartilhados na imersão</li>
              <li>Mini Curso Fundamentos do Emagrecimento</li>
            </ul>
            <div class="v3-ticket__divider"></div>
            <p class="v3-ticket__old-price">De R$ 97,00</p>
            <p class="v3-ticket__price">{PRICE_BASICO}</p>
            <button class="v3-ticket__buy v3-ticket__buy--basic" data-form="normal">Comprar ingresso básico</button>
          </div>

          <!-- VIP -->
          <div class="v3-ticket v3-ticket--vip">
            <div class="v3-ticket__badge">Recomendado</div>
            <span class="v3-ticket__type">VIP</span>
            <h3>Acesso completo</h3>
            
            <details class="v3-ticket-detail">
              <summary>Tudo do básico + <span>ver o que é</span></summary>
              <p>Evento ao vivo, grupo do evento, materiais complementares extras numa plataforma de conteúdos.</p>
            </details>

            <div class="v3-ticket-detail--static">
              🎬 Gravação do evento <span class="v3-tag-year">POR 1 ANO</span>
            </div>

            <details class="v3-ticket-detail">
              <summary>Certificado de 8h <span>ver benefício</span></summary>
              <p>Para contabilizar horas na faculdade ou sinalizar ao paciente que você está em constante evolução.</p>
            </details>

            <details class="v3-ticket-detail">
              <summary>E-book Tópicos Avançados <span>R$ 99</span></summary>
              <p>Nutricosméticos, crononutrição e biogênese mitocondrial com ligação entre teoria e prática clínica.</p>
            </details>

            <details class="v3-ticket-detail">
              <summary>Ebook "Me Formei, e agora?" <span>R$ 59</span></summary>
              <p>Respostas para precificação, retorno, fidelização, sublocação e mais dúvidas de recém-formados.</p>
            </details>

            <details class="v3-ticket-detail">
              <summary>Ebook Desaprendendo a Dieta <span>R$ 39</span></summary>
              <p>Cartilha para o paciente sair da mentalidade de dieta. Educação nutricional verdadeira.</p>
            </details>

            <details class="v3-ticket-detail">
              <summary>Ressaca do Evento (Extra) <span>ver benefício</span></summary>
              <p>Encontro extra no Zoom para recapitular conteúdo e tirar dúvidas pós-imersão.</p>
            </details>

            <details class="v3-ticket-detail">
              <summary>Cashback integral <span>ver como funciona</span></summary>
              <p>O valor investido no VIP volta como desconto na Formação Nutrição Avançada ou na Pós-Graduação.</p>
            </details>

            <div class="v3-ticket__divider"></div>
            <p class="v3-ticket__old-price">De R$ 297,00</p>
            <p class="v3-ticket__price">{PRICE_VIP_PARCELADO}</p>
            <p class="v3-ticket__price-alt">ou {PRICE_VIP_AVISTA} à vista</p>
            <button class="v3-ticket__buy v3-ticket__buy--vip" data-form="vip">Comprar ingresso VIP</button>
          </div>
        </div>

        <div class="v3-guarantee">
          <strong>🛡 Sua compra está protegida pela Garantia de 7 dias</strong>
          <p>Você pode garantir sua vaga, assistir à imersão e, se sentir que o conteúdo não é prático ou aplicável, basta enviar um e-mail para receber 100% de volta. Sem burocracia.</p>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FAQ
         ══════════════════════════════════════ -->
    <section class="v3-section v3-section--no-border">
      <div class="v3-wrap">
        <h2 class="v3-section__title">Perguntas frequentes</h2>
        <div class="v3-faq-list">
          <details class="v3-faq-item">
            <summary>Para quem é essa imersão?</summary>
            <p>Para nutricionistas formados e estudantes de nutrição que atendem pacientes com sobrepeso e querem se atualizar com GLP-1, canetas emagrecedoras e prática clínica avançada.</p>
          </details>
          <details class="v3-faq-item">
            <summary>Vai ficar gravado?</summary>
            <p>A imersão acontece ao vivo no dia 01 de Agosto das 9h às 18h. O Ingresso VIP dá acesso completo às gravações por 1 ano.</p>
          </details>
          <details class="v3-faq-item">
            <summary>E se eu não gostar? Tem reembolso?</summary>
            <p>Sim. Você tem 7 dias de garantia incondicional. Devolvemos 100% do valor sem questionamentos.</p>
          </details>
          <details class="v3-faq-item">
            <summary>Qual é o nível de profundidade?</summary>
            <p>Conteúdo focado em clínica aplicada. Você sai com protocolos e condutas que dá para usar na próxima consulta.</p>
          </details>
          <details class="v3-faq-item">
            <summary>Como funciona o Cashback do VIP?</summary>
            <p>Ao adquirir o ingresso VIP (R$ 147), você recebe 100% do valor como desconto ao se matricular na Formação Nutrição Avançada ou na Pós-Graduação.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         CTA FINAL
         ══════════════════════════════════════ -->
    <section class="v3-final-cta">
      <div class="v3-wrap">
        <h2 class="v3-final-cta__headline">Sua próxima consulta de emagrecimento pode ser diferente.</h2>
        <p class="v3-final-cta__sub">Garanta seu ingresso no {LOTE} antes que o preço suba.</p>
        <a href="#ingressos" class="v3-btn-primary">Escolher meu ingresso</a>
        <p class="v3-final-cta__security">Garantia de 7 dias · Pagamento seguro · Acesso imediato</p>
      </div>
    </section>

  </div>

  <FormModal />
  <T9Tracking />

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="lightbox-overlay" style="display:none;">
    <button class="lightbox-close" id="lightbox-close" aria-label="Fechar">&times;</button>
    <img id="lightbox-img" src="" alt="Depoimento Ampliado" class="lightbox-content-img" />
  </div>

  <!-- Sticky Bottom Bar -->
  <div class="sticky-bottom-bar" id="sticky-bar">
    <div class="sticky-bar-inner">
      <a href="#ingressos" class="btn-sticky-action">Comprar ingresso | {LOTE} 🎟</a>
      <span class="sticky-progress-label">
        Garantia de 7 dias · Ingresso a partir de <strong class="red-price">{PRICE_BASICO}</strong>
      </span>
    </div>
  </div>

  <!-- Video Modal -->
  <div id="video-modal" class="video-modal">
    <div class="video-modal-content">
      <button class="video-modal-close" id="close-modal-btn">&times;</button>
      <div class="video-iframe-container">
        <iframe id="video-iframe" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    </div>
  </div>

  <script>
    // Lightbox
    const lightbox = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');

    document.querySelectorAll('[data-zoom-img]').forEach(card => {
      card.addEventListener('click', () => {
        const src = (card as HTMLElement).dataset.zoomImg;
        if (src && lightbox && lightboxImg) {
          lightboxImg.src = src;
          lightbox.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    });

    function closeLightbox() {
      if (lightbox) lightbox.style.display = 'none';
      if (lightboxImg) lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

    // Sticky Bar
    const stickyBar = document.getElementById('sticky-bar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 450) {
        stickyBar?.classList.add('sticky-bottom-bar--visible');
      } else {
        stickyBar?.classList.remove('sticky-bottom-bar--visible');
      }
    });

    // Video Modal
    const modal = document.getElementById('video-modal');
    const iframe = document.getElementById('video-iframe') as HTMLIFrameElement;
    const closeBtn = document.getElementById('close-modal-btn');
    document.querySelectorAll('.btn-ver-chamada').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (iframe) iframe.src = 'https://www.youtube.com/embed/vPnW2rWVQHY?autoplay=1';
        modal?.classList.add('active');
      });
    });
    const closeModal = () => { modal?.classList.remove('active'); if (iframe) iframe.src = ''; };
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  </script>

</Layout>
