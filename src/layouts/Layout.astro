---
import '../styles/global.css';

interface Props {
  title: string;
  theme?: 'green' | 'blue';
  hideHeader?: boolean;
  hideUrgency?: boolean;
  hideChatbase?: boolean;
  urgencyMessage?: string;
}

const { title, theme = 'green', hideHeader = false, hideUrgency = false, hideChatbase = false, urgencyMessage } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">
    
    <title>{title}</title>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2794166034202244');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
           src="https://www.facebook.com/tr?id=2794166034202244&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <!-- Header Sticky -->
    {!hideUrgency && (
      urgencyMessage ? (
        <div class="urgency-strip urgency-strip--critical" role="status">
          <span class="urgency-strip__inner">⚠ {urgencyMessage}</span>
        </div>
      ) : (
        <div class="urgency-strip" aria-label="Contador de virada do lote">
          <span class="urgency-strip__inner">
            <span class="urgency-strip__badge" id="lote-strip-badge">LOTE 01</span>
            <span class="urgency-strip__divider" aria-hidden="true"></span>
            <span class="urgency-strip__label" id="lote-strip-label">Virada em</span>
            <span class="urgency-strip__timer" id="countdown"></span>
          </span>
        </div>
      )
    )}

    <!-- Navegação -->
    {!hideHeader && (
      <header class="main-header">
        <div class="container header-grid">
          <div class="logo">
            NUTRIÇÃO <span class="green">AVANÇADA</span>
          </div>
          <nav class="desktop-nav">
            <a href="#imersao">A Imersão</a>
            <a href="#conteudo">Conteúdo</a>
            <a href="#time">Time</a>
          </nav>
          <div class="header-actions">
            <a href="#preco" class="btn-nav">GARANTIR VAGA</a>
          </div>
        </div>
      </header>
    )}

    <main>
      <slot />
    </main>

    <script>
      // Datas predefinidas para viradas de lotes (Evento: 01/08/2026)
      const LAYOUT_LOTES = [
        { nome: 'LOTE ZERO', inicio: new Date('2026-06-01T00:00:00').getTime(), limite: new Date('2026-07-15T23:59:59').getTime() },
        { nome: 'LOTE 01', inicio: new Date('2026-07-15T00:00:00').getTime(), limite: new Date('2026-07-21T23:59:59').getTime() },
        { nome: 'LOTE 02', inicio: new Date('2026-07-21T00:00:00').getTime(), limite: new Date('2026-07-30T23:59:59').getTime() },
        { nome: 'LOTE 03', inicio: new Date('2026-07-30T00:00:00').getTime(), limite: new Date('2026-08-01T09:00:00').getTime() }
      ];

      function updateLayoutCountdown() {
        const now = new Date().getTime();
        
        // Identificar lote ativo
        let lote = LAYOUT_LOTES[LAYOUT_LOTES.length - 1];
        for (let i = 0; i < LAYOUT_LOTES.length; i++) {
          if (now < LAYOUT_LOTES[i].limite) {
            lote = LAYOUT_LOTES[i];
            break;
          }
        }

        const badge = document.getElementById('lote-strip-badge');
        const label = document.getElementById('lote-strip-label');
        const el = document.getElementById('countdown');
        if (!el) return;

        if (badge) badge.textContent = lote.nome;

        const diff = lote.limite - now;
        if (diff < 0) {
          if (label) label.textContent = '';
          el.textContent = 'VAGAS LIMITADAS';
          return;
        }

        if (label) label.textContent = 'Virada em:';
        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);
        el.textContent = `${d}d ${h}h ${m}m ${s}s`;
      }
      setInterval(updateLayoutCountdown, 1000);
      updateLayoutCountdown();
    </script>
    
    <!-- Swiper.js CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
    <!-- Chatbase Script -->
    {!hideChatbase && (
      <script is:inline>
      (function(){if(!window.chatbase||window.chatbase("getState")!=="initialized"){window.chatbase=(...arguments)=>{if(!window.chatbase.q){window.chatbase.q=[]}window.chatbase.q.push(arguments)};window.chatbase=new Proxy(window.chatbase,{get(target,prop){if(prop==="q"){return target.q}return(...args)=>target(prop,...args)}})}const onLoad=function(){const script=document.createElement("script");script.src="https://www.chatbase.co/embed.min.js";script.id="ShXsE03mgHQfu82jgWPoZ";script.domain="www.chatbase.co";document.body.appendChild(script)};if(document.readyState==="complete"){onLoad()}else{window.addEventListener("load",onLoad)}})();
      </script>
    )}
  </body>
</html>

<style>
  .urgency-strip {
    min-height: 38px;
    background: #0f9f49;
    color: #ffffff;
    padding: 7px 12px;
    text-align: center;
    position: relative;
    z-index: 101;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  .urgency-strip__inner {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    line-height: 1;
    font-weight: 800;
  }

  .urgency-strip--critical {
    background: #c91414;
  }

  .urgency-strip--critical .urgency-strip__inner {
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .urgency-strip__badge {
    font-weight: 900;
    text-transform: uppercase;
  }

  .urgency-strip__divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.45);
  }

  .urgency-strip__label {
    color: rgba(255, 255, 255, 0.88);
    font-weight: 700;
  }

  .urgency-strip__timer {
    min-width: 94px;
    color: #ffffff;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    text-align: left;
  }

  .main-header {
    background: rgba(2, 9, 4, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 12px 0;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .header-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 800;
    font-size: 16px;
    color: #F3F4F6;
    line-height: 1;
  }

  .logo .green { color: #22c55e; }

  .desktop-nav {
    display: flex;
    gap: 24px;
  }

  .desktop-nav a {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
  }

  .desktop-nav a:hover { color: #22c55e; }

  .btn-nav {
    background: #16A34A;
    color: white;
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .urgency-strip {
      min-height: 34px;
      padding: 6px 8px;
    }

    .urgency-strip__inner {
      gap: 6px;
      font-size: 11px;
    }

    .urgency-strip__divider {
      height: 14px;
    }

    .urgency-strip__timer {
      min-width: 84px;
    }

    .desktop-nav { display: none; }
    .main-header { padding: 10px 16px; }
  }
</style>
